<Project Sdk="Microsoft.NET.Sdk">
  <!-- Example plugin. EnableDynamicLoading emits the deps.json the host's AssemblyDependencyResolver
       needs. The Abstractions SDK is referenced but NOT shipped with the plugin (Private=false) — the
       host provides it so plugin types unify with the host's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Downloader.Desktop.Plugins.Abstractions\Downloader.Desktop.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
