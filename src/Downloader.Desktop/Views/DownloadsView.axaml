<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Downloader.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="460"
             x:Class="Downloader.Desktop.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <DockPanel Margin="16">
        <!-- Selection toolbar -->
        <Border DockPanel.Dock="Top" Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <CheckBox Content="Select all" IsChecked="{Binding SelectAll, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="2 0 8 0" />
                <Button Classes="icon" Command="{Binding StartSelectedCommand}" ToolTip.Tip="Start selected">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PlayRegular}" />
                        <TextBlock Text="Start" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="icon" Command="{Binding PauseSelectedCommand}" ToolTip.Tip="Pause selected">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PauseRegular}" />
                        <TextBlock Text="Pause" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="icon" Command="{Binding StopSelectedCommand}" ToolTip.Tip="Stop selected">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource StopRegular}" />
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="icon" Command="{Binding RemoveSelectedCommand}" ToolTip.Tip="Remove selected">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                        <TextBlock Text="Remove" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Panel>
        <DataGrid x:Name="Root"
                  ItemsSource="{Binding ItemsView}"
                  DoubleTapped="OnRowDoubleTapped"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  RowHeight="46"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemBaseLowColor}"
                  CornerRadius="10">
            <DataGrid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TextBlock.failed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style Selector="TextBlock.pending">
                    <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </Style>
                <!-- Select the whole row, no per-cell focus border (#13) -->
                <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="38">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="FileName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}" />
                                        <MenuItem Header="Open file" Command="{Binding OpenFileCommand}" />
                                        <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <PathIcon Data="{Binding FileKind, Converter={x:Static conv:FileKindToIconConverter.Instance}}"
                                          Height="16" Width="16"
                                          Foreground="{DynamicResource SystemAccentColor}" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Classes.failed="{Binding HasError}"
                                           Classes.pending="{Binding IsNamePending}"
                                           ToolTip.Tip="{Binding ErrorMessage}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Size" Width="90" SortMemberPath="Size">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Progress" Width="170" SortMemberPath="Progress">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6 0" Spacing="3">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" />
                                <!-- Running shows %, other states show a colored badge -->
                                <TextBlock Text="{Binding StatusText}" FontSize="11" IsVisible="{Binding !ShowStatusBadge}"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                                <Border Classes="badge" IsVisible="{Binding ShowStatusBadge}"
                                        HorizontalAlignment="Center"
                                        Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Speed" Width="90" SortMemberPath="Speed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="168">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Spacing="1" VerticalAlignment="Center">
                                <Button Classes="icon" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" ToolTip.Tip="Pause">
                                    <PathIcon Data="{DynamicResource PauseRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" ToolTip.Tip="Resume">
                                    <PathIcon Data="{DynamicResource PlayRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" ToolTip.Tip="Retry">
                                    <PathIcon Data="{DynamicResource PlayRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" ToolTip.Tip="Stop">
                                    <PathIcon Data="{DynamicResource StopRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding OpenFileCommand}" IsVisible="{Binding IsCompleted}" ToolTip.Tip="Open file">
                                    <PathIcon Data="{DynamicResource DocumentRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open folder">
                                    <PathIcon Data="{DynamicResource FolderRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                                    <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" IsHitTestVisible="False">
            <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="40"
                      Foreground="{DynamicResource SystemBaseMediumLowColor}" />
            <TextBlock Text="No downloads yet" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Paste a link in the box above and click Add to begin."
                       Foreground="{DynamicResource SystemBaseMediumColor}" HorizontalAlignment="Center" />
        </StackPanel>
        </Panel>
    </DockPanel>
</UserControl>
