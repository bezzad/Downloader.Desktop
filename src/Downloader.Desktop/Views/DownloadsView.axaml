<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Downloader.Desktop.Converters"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="460"
             x:Class="Downloader.Desktop.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <!-- Tight to the edges (#8): minimal padding, no surrounding card/border.
         The action toolbar lives in MainWindow now (visible on every page), not here. -->
    <Panel Margin="5">
        <DataGrid x:Name="Root"
                  ItemsSource="{Binding ItemsView}"
                  DoubleTapped="OnRowDoubleTapped"
                  SelectionChanged="OnSelectionChanged"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  ClipboardCopyMode="None"
                  RowHeight="46"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  ColumnHeaderHeight="38"
                  Background="Transparent"
                  BorderThickness="0"
                  BorderBrush="Transparent"
                  CornerRadius="10">
            <DataGrid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <!-- Select the whole row, no per-cell focus border (#13) -->
                <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <!-- Drag-to-reorder feedback: the row under the pointer is highlighted as the pointer
                     moves over it, and the dragged source row is dimmed. -->
                <Style Selector="DataGridRow.droptarget">
                    <Setter Property="Background" Value="{DynamicResource RowSelectionBrush}" />
                </Style>
                <Style Selector="DataGridRow.dragging">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </DataGrid.Styles>
            <!-- One right-click menu for every row. It acts on the selected rows; the view makes a
                 right-clicked row outside the selection the only selected one first (OnContextRequested).
                 Shortcut labels (InputGesture) and the matching grid key bindings are set in code-behind so
                 macOS gets Cmd instead of Ctrl. -->
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="RowMenu">
                    <MenuItem x:Name="MenuOpen" Header="{i18n:Tr Menu_Open}" Command="{Binding OpenCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource DocumentRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{i18n:Tr Action_OpenFolder}" Command="{Binding OpenFolderMenuCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource FolderRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuResume" Header="{i18n:Tr Action_Resume}" Command="{Binding ResumeMenuCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource PlayRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuPause" Header="{i18n:Tr Action_Pause}" Command="{Binding PauseMenuCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource PauseRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{i18n:Tr Action_Stop}" Command="{Binding StopMenuCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource StopRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{i18n:Tr Menu_Restart}" Command="{Binding RestartCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource ArrowDownloadRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuMoveToQueue" Header="{i18n:Tr Menu_MoveToQueue}"
                              ItemsSource="{Binding MoveToQueueTargets}" IsVisible="{Binding ShowQueue}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource ArrowMoveRegular}" /></MenuItem.Icon>
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" x:DataType="vm:QueueActionTarget"
                                          BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="{i18n:Tr Cat_Category}" ItemsSource="{Binding MenuCategoryChoices}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource TabsRegular}" /></MenuItem.Icon>
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" x:DataType="vm:CategoryChoice"
                                          BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="{i18n:Tr Menu_Copy}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource CopyRegular}" /></MenuItem.Icon>
                        <MenuItem x:Name="MenuCopyLink" Header="{i18n:Tr Menu_CopyLink}" Command="{Binding CopyLinkCommand}" />
                        <MenuItem Header="{i18n:Tr Menu_CopyJson}" Command="{Binding CopyJsonCommand}" />
                        <MenuItem Header="{i18n:Tr Menu_CopyCurl}" Command="{Binding CopyCurlCommand}" />
                    </MenuItem>
                    <!-- Plugin-offered action on the selected completed download (e.g. "Add to Ollama"). -->
                    <MenuItem Header="{Binding MenuPostActionLabel}" Command="{Binding PostActionMenuCommand}"
                              IsVisible="{Binding HasMenuPostAction}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource SendRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{i18n:Tr Action_Archive}" Command="{Binding ArchiveSelectedCommand}"
                              IsVisible="{Binding !IsArchivedView}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource ArchiveRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{i18n:Tr Action_Restore}" Command="{Binding UnarchiveSelectedCommand}"
                              IsVisible="{Binding IsArchivedView}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource ArchiveRestoreRegular}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuDelete" Header="{i18n:Tr Menu_Delete}" Command="{Binding RemoveSelectedCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource DeleteRegular}" Foreground="IndianRed" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuProperties" Header="{i18n:Tr Menu_Properties}" Command="{Binding PropertiesCommand}">
                        <MenuItem.Icon><PathIcon Data="{StaticResource InfoRegular}" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- Drag handle (6-dot grip): drag a row up/down to reorder (= queue pump priority).
                     Dropping onto a row in another queue moves this item into that queue. -->
                <DataGridTemplateColumn Width="28" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <Border Background="Transparent" Cursor="SizeNorthSouth"
                                    PointerPressed="OnGripPointerPressed"
                                    PointerMoved="OnGripPointerMoved"
                                    PointerReleased="OnGripPointerReleased"
                                    PointerCaptureLost="OnGripCaptureLost"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    ToolTip.Tip="{i18n:Tr Action_Reorder}">
                                <PathIcon Data="{DynamicResource GripDotsRegular}" Width="14" Height="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Tri-state "select all" lives in the header now (left of Name), not in the toolbar (#5) -->
                <!-- Header hosts the tri-state "select all" — but this DataGrid won't render a *control*
                     in a column header (only string headers show), so the checkbox is overlaid over this
                     column's header band instead (see the CheckBox after the DataGrid). -->
                <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- MinWidth matters once the category sidebar is open: Name is the only star column,
                     so without a floor it absorbs the whole 204px the sidebar takes and the file names
                     collapse to three characters. When even the floor does not fit, the view hides the
                     optional columns (Time left, Queue) rather than let the grid crush the rest. -->
                <DataGridTemplateColumn Header="{i18n:Tr Col_Name}" Width="*" MinWidth="160"
                                        SortMemberPath="FileName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <!-- The category icon, in the category's color; hovering names the category. -->
                                <PathIcon Data="{Binding FileKind, Converter={x:Static conv:FileKindToIconConverter.Instance}}"
                                          Height="16" Width="16" VerticalAlignment="Center"
                                          Foreground="{Binding CategoryColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                          ToolTip.Tip="{Binding CategoryName}" />
                                <!-- Name keeps a single consistent style across all states (#7); only the
                                     progress bar color + status text below it reflect the state. -->
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding NameTooltip}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:Tr Col_Queue}" Width="110" SortMemberPath="QueueName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding QueueName}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:Tr Col_Size}" Width="90" SortMemberPath="Size">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr Col_Progress}" Width="150" SortMemberPath="Progress">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6 0" Spacing="3">
                                <!-- Only the bar color changes with state; the text below shows "%· state" (#7) -->
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                                             Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr Col_Speed}" Width="90" SortMemberPath="Speed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr Col_TimeLeft}" Width="90" SortMemberPath="TimeLeftText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding TimeLeftText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Tri-state "select all", overlaid on the first column's header band (the DataGrid won't
             render a control inside a column header, so it lives here, aligned to that column). -->
        <CheckBox IsChecked="{Binding SelectAllState, Mode=TwoWay}" IsThreeState="True"
                  IsVisible="{Binding !IsEmpty}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36 9 0 0"
                  ToolTip.Tip="{i18n:Tr Grid_SelectAll}" />

        <!-- Empty state: nothing downloaded yet. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" IsHitTestVisible="False">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsEmpty" />
                    <Binding Path="!HasFilter" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="40"
                      Foreground="{DynamicResource SystemBaseMediumLowColor}" />
            <TextBlock Text="{i18n:Tr Empty_Title}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{i18n:Tr Empty_Hint}"
                       Foreground="{DynamicResource SystemBaseMediumColor}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Empty state: there ARE downloads, the filters are hiding them. A different message and a
             way out, so nobody concludes their list was lost. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsEmpty" />
                    <Binding Path="HasFilter" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <PathIcon Data="{StaticResource SearchRegular}" Height="34"
                      HorizontalAlignment="Center"
                      Foreground="{DynamicResource SystemBaseMediumLowColor}" />
            <TextBlock Text="{i18n:Tr Cat_EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <Button Content="{i18n:Tr Cat_ClearFilters}" Cursor="Hand" HorizontalAlignment="Center"
                    CornerRadius="8" Padding="14 6" Command="{Binding ClearFiltersCommand}" />
        </StackPanel>

        <!-- Drag overlay: hosts the floating "ghost" snapshot of the row being dragged so it visibly
             sticks under the cursor (the OS DragDrop session shows no moving visual on X11). -->
        <Canvas x:Name="DragOverlay" IsHitTestVisible="False" ClipToBounds="False" />
    </Panel>
</UserControl>
