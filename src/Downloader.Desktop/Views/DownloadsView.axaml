<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Downloader.Desktop.Converters"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="460"
             x:Class="Downloader.Desktop.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <!-- Tight to the edges (#8): minimal padding, no surrounding card/border -->
    <DockPanel Margin="5">
        <!-- Action toolbar: square buttons, icon on top + label below. The first group acts on the
             selected rows (disabled when nothing is checked); the second group is selection-independent. -->
        <Border DockPanel.Dock="Top" Margin="0 0 0 6">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="tool" Command="{Binding StartSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Start}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource PlayRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_Start}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding PauseSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Pause}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource PauseRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_Pause}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding StopSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Stop}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource StopRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_Stop}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding RemoveSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Remove}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource DeleteRegular}" HorizontalAlignment="Center" Foreground="#E5594F" />
                        <TextBlock Text="{i18n:Tr Action_Remove}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="6 6" Background="{DynamicResource SystemBaseLowColor}" />

                <!-- Start a whole queue (selection-independent): pick which queue from the dropdown (#2) -->
                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Action_StartQueue}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding StartQueueTargets}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" x:DataType="vm:QueueActionTarget"
                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource PlayStackRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_StartQueue}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Stop a whole queue (selection-independent): pick which queue from the dropdown (#3) -->
                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Action_StopQueue}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding StopQueueTargets}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" x:DataType="vm:QueueActionTarget"
                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource StopStackRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_StopQueue}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Stop every item, regardless of queue or selection (#4) -->
                <Button Classes="tool" Command="{Binding StopAllCommand}" ToolTip.Tip="{i18n:Tr Action_StopAll}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource StopAllRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_StopAll}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Open the Queues manager (dialog). Nav lives here now (the left rail was removed). -->
                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Nav_Queues}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowQueuesCommand}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource TabsRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Nav_Queues}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="6 6" Background="{DynamicResource SystemBaseLowColor}" />

                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Nav_Scheduler}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowSchedulerCommand}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource ClockRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Nav_Scheduler}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Nav_Settings}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowSettingViewCommand}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource SettingsRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Nav_Settings}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Panel>
        <DataGrid x:Name="Root"
                  ItemsSource="{Binding ItemsView}"
                  DoubleTapped="OnRowDoubleTapped"
                  SelectionChanged="OnSelectionChanged"
                  DragDrop.AllowDrop="True"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  RowHeight="46"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  ColumnHeaderHeight="38"
                  Background="Transparent"
                  BorderThickness="0"
                  BorderBrush="Transparent"
                  CornerRadius="10">
            <DataGrid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <!-- Select the whole row, no per-cell focus border (#13) -->
                <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <!-- Drag-to-reorder feedback: the row under the pointer is highlighted as the pointer
                     moves over it, and the dragged source row is dimmed. -->
                <Style Selector="DataGridRow.droptarget">
                    <Setter Property="Background" Value="{DynamicResource RowSelectionBrush}" />
                </Style>
                <Style Selector="DataGridRow.dragging">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <!-- Drag handle (6-dot grip): drag a row up/down to reorder (= queue pump priority).
                     Dropping onto a row in another queue moves this item into that queue. -->
                <DataGridTemplateColumn Width="28" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <Border Background="Transparent" Cursor="SizeNorthSouth"
                                    PointerPressed="OnGripPointerPressed"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    ToolTip.Tip="{i18n:Tr Action_Reorder}">
                                <PathIcon Data="{DynamicResource GripDotsRegular}" Width="14" Height="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Tri-state "select all" lives in the header now (left of Name), not in the toolbar (#5) -->
                <!-- Header hosts the tri-state "select all" — but this DataGrid won't render a *control*
                     in a column header (only string headers show), so the checkbox is overlaid over this
                     column's header band instead (see the CheckBox after the DataGrid). -->
                <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:Tr Col_Name}" Width="*" SortMemberPath="FileName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{i18n:Tr Action_CopyUrl}" Command="{Binding CopyUrlCommand}" />
                                        <MenuItem Header="{i18n:Tr Action_OpenFile}" Command="{Binding OpenFileCommand}" />
                                        <MenuItem Header="{i18n:Tr Action_OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="{i18n:Tr Action_Remove}" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <PathIcon Data="{Binding FileKind, Converter={x:Static conv:FileKindToIconConverter.Instance}}"
                                          Height="16" Width="16"
                                          Foreground="{DynamicResource SystemAccentColor}" />
                                <!-- Name keeps a single consistent style across all states (#7); only the
                                     progress bar color + status text below it reflect the state. -->
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ErrorMessage}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:Tr Col_Queue}" Width="120" SortMemberPath="QueueName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding QueueName}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:Tr Col_Size}" Width="90" SortMemberPath="Size">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr Col_Progress}" Width="170" SortMemberPath="Progress">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6 0" Spacing="3">
                                <!-- Only the bar color changes with state; the text below shows "%· state" (#7) -->
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6"
                                             Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr Col_Speed}" Width="90" SortMemberPath="Speed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{i18n:Tr Col_TimeLeft}" Width="90" SortMemberPath="TimeLeftText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding TimeLeftText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="168">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Spacing="1" VerticalAlignment="Center">
                                <Button Classes="icon" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" ToolTip.Tip="{i18n:Tr Action_Pause}">
                                    <PathIcon Data="{DynamicResource PauseRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" ToolTip.Tip="{i18n:Tr Action_Resume}">
                                    <PathIcon Data="{DynamicResource PlayRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" ToolTip.Tip="{i18n:Tr Action_Retry}">
                                    <PathIcon Data="{DynamicResource PlayRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" ToolTip.Tip="{i18n:Tr Action_Stop}">
                                    <PathIcon Data="{DynamicResource StopRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding OpenFileCommand}" IsVisible="{Binding IsCompleted}" ToolTip.Tip="{i18n:Tr Action_OpenFile}">
                                    <PathIcon Data="{DynamicResource DocumentRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{i18n:Tr Action_OpenFolder}">
                                    <PathIcon Data="{DynamicResource FolderRegular}" />
                                </Button>
                                <Button Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="{i18n:Tr Action_Remove}">
                                    <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tri-state "select all", overlaid on the first column's header band (the DataGrid won't
             render a control inside a column header, so it lives here, aligned to that column). -->
        <CheckBox IsChecked="{Binding SelectAllState, Mode=TwoWay}" IsThreeState="True"
                  IsVisible="{Binding !IsEmpty}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="42 9 0 0"
                  ToolTip.Tip="{i18n:Tr Grid_SelectAll}" />

        <!-- Empty state -->
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" IsHitTestVisible="False">
            <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="40"
                      Foreground="{DynamicResource SystemBaseMediumLowColor}" />
            <TextBlock Text="{i18n:Tr Empty_Title}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{i18n:Tr Empty_Hint}"
                       Foreground="{DynamicResource SystemBaseMediumColor}" HorizontalAlignment="Center" />
        </StackPanel>
        </Panel>
    </DockPanel>
</UserControl>
