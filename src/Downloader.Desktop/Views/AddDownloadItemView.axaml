<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Downloader.Desktop.ViewModels"
        xmlns:m="clr-namespace:Downloader.Desktop.Models"
        xmlns:v="clr-namespace:Downloader.Desktop.Views"
        xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
        xmlns:services="clr-namespace:Downloader.Desktop.Services"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="460"
        Width="560" Height="460"
        MinWidth="480" MinHeight="360"
        CanResize="True"
        FontSize="{StaticResource DefaultFontSize}"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="/Assets/downloader.png"
        x:Class="Downloader.Desktop.Views.AddDownloadItemView"
        x:DataType="viewModels:AddDownloadItemViewModel"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding FlowDirection, Source={x:Static services:Localizer.Instance}}"
        Title="Add download">

    <Panel>
    <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
            CornerRadius="10" ClipToBounds="True" Background="{DynamicResource SystemRegionColor}">
    <DockPanel>
    <v:TitleBar DockPanel.Dock="Top" Title="{i18n:Tr Add_Title}" ShowMinMax="False" />
    <Grid Margin="28 18 28 28" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Link(s) -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{i18n:Tr Add_Links}" Margin="0 0 0 4" />
        <Panel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 14" ClipToBounds="True">
            <TextBox x:Name="UrlBox"
                     Text="{Binding Urls, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="NoWrap" Height="64"
                     CornerRadius="6"
                     VerticalContentAlignment="Top"
                     PlaceholderText="{Binding LinksPlaceholder}" />
            <!-- Clipboard suggestion: dimmed, non-committed, always a SINGLE line ("N links" summary for
                 many) and clipped to the box so a big clipboard can't overflow the dialog. Enter/Tab
                 (handled in code-behind) accepts the full clipboard content. -->
            <TextBlock IsHitTestVisible="False"
                       IsVisible="{Binding ShowClipboardSuggestion}"
                       Text="{Binding ClipboardSuggestionDisplay}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                       Margin="12 8 12 0" VerticalAlignment="Top" HorizontalAlignment="Left"
                       Foreground="{DynamicResource SystemAccentColor}" Opacity="0.65" />
            <TextBlock IsHitTestVisible="False"
                       IsVisible="{Binding ShowClipboardSuggestion}"
                       Text="{i18n:Tr Add_ClipboardHint}"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       Margin="0 0 8 6" FontSize="11"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
        </Panel>

        <!-- Save folder -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:Tr Add_SaveTo}" Margin="0 0 0 4" />
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0 0 0 14">
            <TextBox Grid.Column="0" Text="{Binding StorageFolderPath, Mode=TwoWay}"
                     CornerRadius="6" VerticalContentAlignment="Center"
                     PlaceholderText="{i18n:Tr Add_ChooseFolder}" />
            <Button Grid.Column="1" Margin="8 0 0 0" Padding="10"
                    Command="{Binding SelectFileStoragePathCommand}"
                    ToolTip.Tip="{i18n:Tr Tooltip_Browse}">
                <PathIcon Data="{StaticResource FolderRegular}" Height="16" />
            </Button>
        </Grid>

        <!-- Optional file name + queue -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10" VerticalAlignment="Top">
            <StackPanel Spacing="4">
                <TextBlock Text="{i18n:Tr Add_FileName}" />
                <!-- Disabled for multi-link adds (per-file names don't apply — folder only). -->
                <TextBox Text="{Binding Filename, Mode=TwoWay}"
                         IsEnabled="{Binding IsFilenameEnabled}"
                         CornerRadius="6" VerticalContentAlignment="Center"
                         PlaceholderText="{i18n:Tr Add_FileNamePlaceholder}" />
                <!-- Single-link: live name/size resolution hint. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSingleLink}">
                    <TextBlock Text="{i18n:Tr Add_Resolving}" IsVisible="{Binding Resolving}"
                               Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12" />
                    <TextBlock Text="{Binding SizeText}" IsVisible="{Binding HasSizeText}"
                               Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding ShowQueuePicker}">
                <TextBlock Text="{i18n:Tr Add_Queue}" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Queues}"
                          SelectedItem="{Binding SelectedQueue}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:DownloadQueue">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Actions: [inline new-queue name row when adding] … [Add queue] [Add] -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 16 0 0">
            <!-- Inline queue-name entry (shown by the Add-queue button; Enter confirms). -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsAddingQueue}">
                <TextBox x:Name="QueueNameBox" Width="160" CornerRadius="6" VerticalContentAlignment="Center"
                         Text="{Binding NewQueueName, Mode=TwoWay}"
                         PlaceholderText="{i18n:Tr Add_QueueNamePlaceholder}"
                         KeyDown="OnQueueNameKeyDown" />
                <Button Classes="icon" Command="{Binding ConfirmAddQueueCommand}" ToolTip.Tip="{i18n:Tr Add_QueueConfirm}">
                    <PathIcon Data="{DynamicResource CheckmarkRegular}" Height="14" />
                </Button>
                <Button Classes="icon" Command="{Binding CancelAddQueueCommand}" ToolTip.Tip="{i18n:Tr Add_QueueCancel}">
                    <PathIcon Data="{DynamicResource DismissRegular}" Height="14" />
                </Button>
            </StackPanel>
            <!-- Same style as the Add button, to its left (author's spec). -->
            <Button Content="{i18n:Tr Add_AddQueue}" Padding="20 8" Cursor="Hand"
                    HorizontalContentAlignment="Center"
                    Classes="accent"
                    IsVisible="{Binding CanAddQueue}"
                    Command="{Binding AddQueueCommand}" />
            <Button Content="{i18n:Tr Add_Download}" Padding="20 8" Cursor="Hand"
                    HorizontalContentAlignment="Center"
                    Classes="accent"
                    IsEnabled="{Binding CanDownload}"
                    Command="{Binding StartDownloadCommand}" />
        </StackPanel>
    </Grid>
    </DockPanel>
    </Border>
    <v:ResizeGrips />
    </Panel>
</Window>
