<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Downloader.Desktop.ViewModels"
        xmlns:m="clr-namespace:Downloader.Desktop.Models"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="380"
        Width="560" Height="380"
        CanResize="False"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{DynamicResource ThemeBackgroundColor}"
        x:Class="Downloader.Desktop.Views.AddDownloadItemView"
        x:DataType="viewModels:AddDownloadItemViewModel"
        WindowStartupLocation="CenterOwner"
        Title="Add download">

    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Add download" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 18" />

        <!-- Link -->
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Link" Margin="0 0 0 4" />
        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 Text="{Binding Url, Mode=TwoWay}"
                 CornerRadius="6" Margin="0 0 0 14"
                 VerticalContentAlignment="Center"
                 PlaceholderText="https://…" />

        <!-- Save folder -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Save to" Margin="0 0 0 4" />
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0 0 0 14">
            <TextBox Grid.Column="0" Text="{Binding StorageFolderPath, Mode=TwoWay}"
                     CornerRadius="6" VerticalContentAlignment="Center"
                     PlaceholderText="Choose a folder" />
            <Button Grid.Column="1" Margin="8 0 0 0" Padding="10"
                    Command="{Binding SelectFileStoragePathCommand}"
                    ToolTip.Tip="Browse">
                <PathIcon Data="{StaticResource FolderRegular}" Height="16" />
            </Button>
        </Grid>

        <!-- Optional file name + queue -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10" VerticalAlignment="Top">
            <StackPanel Spacing="4">
                <TextBlock Text="File name (optional)" />
                <TextBox Text="{Binding Filename, Mode=TwoWay}"
                         CornerRadius="6" VerticalContentAlignment="Center"
                         PlaceholderText="Leave empty to detect automatically from the link" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding ShowQueuePicker}">
                <TextBlock Text="Queue" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Queues}"
                          SelectedItem="{Binding SelectedQueue}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:DownloadQueue">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 16 0 0">
            <Button Content="Download" Padding="20 8" Cursor="Hand"
                    HorizontalContentAlignment="Center"
                    Classes="accent"
                    IsEnabled="{Binding CanDownload}"
                    Command="{Binding StartDownloadCommand}" />
        </StackPanel>
    </Grid>
</Window>
