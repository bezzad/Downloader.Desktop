<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="Downloader.Desktop.Views.PluginsView"
             x:DataType="vm:PluginsViewModel">

    <!-- Embeddable (no outer ScrollViewer) — hosted inside the Settings page's collapsible Plugins section. -->
    <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{i18n:Tr Plugins_Desc}" TextWrapping="Wrap" MaxWidth="520"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{i18n:Tr Plugins_OpenFolder}" Padding="12 8"
                        VerticalAlignment="Center" Margin="0 0 8 0" Command="{Binding OpenFolderCommand}" />
                <Button Grid.Column="2" Classes="accent" Content="{i18n:Tr Plugins_Install}" Padding="14 8"
                        VerticalAlignment="Center" Command="{Binding InstallCommand}" />
            </Grid>

            <!-- Empty state -->
            <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="22">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <PathIcon Data="{DynamicResource AppsListRegular}" Height="28" Width="28"
                              HorizontalAlignment="Center" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Text="{i18n:Tr Plugins_Empty}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Text="{i18n:Tr Plugins_Empty_Hint}" HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginRowViewModel">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Background="{DynamicResource SystemListMediumColor}" CornerRadius="6" Padding="6 1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionText}" FontSize="11"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                                    <TextBlock Text="{Binding Author}" FontSize="11"
                                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                                </StackPanel>
                                <!-- Update available (optional plugins only): Accept downloads+verifies+swaps. -->
                                <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" Margin="0 0 8 0"
                                        Padding="12 6" IsVisible="{Binding UpdateAvailable}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Command="{Binding UpdateCommand}" ToolTip.Tip="{i18n:Tr Plugins_UpdateAvailable}">
                                    <TextBlock Text="{i18n:Tr Plugins_Update}" />
                                </Button>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                <!-- Built-in plugins ship with the app: disable-only, no Remove. -->
                                <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center" Margin="6 0 0 0"
                                        IsVisible="{Binding CanRemove}"
                                        Command="{Binding RemoveCommand}" ToolTip.Tip="{i18n:Tr Plugins_Remove}">
                                    <PathIcon Data="{DynamicResource DeleteRegular}" Width="16" Height="16"
                                              Foreground="{DynamicResource SystemErrorTextColor}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== More plugins (optional / catalog tier) =====
                 Optional plugins are not bundled; the app fetches this list from the latest release and
                 the user adds one on demand (download → verify sha256 → load). De-emphasized vs. installed
                 plugins. Hidden entirely when the catalog is empty/unreachable. -->
            <StackPanel Spacing="10" IsVisible="{Binding HasCatalog}">
                <Separator Margin="0 4" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{i18n:Tr Plugins_More}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{i18n:Tr Plugins_MoreHint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding CatalogPlugins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogPluginRowViewModel">
                            <!-- Lower opacity marks these as not-yet-installed. -->
                            <Border Classes="card" Opacity="0.85">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Background="{DynamicResource SystemListMediumColor}" CornerRadius="6" Padding="6 1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding VersionText}" FontSize="11"
                                                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="90" Margin="10">
                                            <Button Classes="accent" HorizontalAlignment="Right" Padding="14 8" Width="90"
                                                    Command="{Binding AddCommand}" IsVisible="{Binding !IsBusy}">
                                                <TextBlock Text="{i18n:Tr Plugins_Add}" HorizontalAlignment="Center" />
                                            </Button>
                                            <!-- Busy: the Add button is replaced by a compact percent + a
                                                 cancel (×) affordance inside it; the total progress bar for
                                                 all dependencies being fetched sits under it and matches the
                                                 replaced Add button's width (the nested panel sizes to the
                                                 percent pill, and the bar/text stretch to fill it). -->
                                            <StackPanel Spacing="4" HorizontalAlignment="Right" Width="90" IsVisible="{Binding IsBusy}">
                                                <Border x:Name="BusyPill" Background="{DynamicResource SystemAccentColor}"
                                                        Padding="8 6" CornerRadius="6">
                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                                   Foreground="White" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left" />
                                                        <Button Grid.Column="1" Classes="icon" Padding="2" Width="18" Height="18"
                                                                Command="{Binding CancelCommand}"
                                                                ToolTip.Tip="{i18n:Tr Plugins_Cancel}">
                                                            <PathIcon Data="{StaticResource DismissRegular}" Width="9" Height="9"
                                                                      Foreground="White" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ProgressBar Minimum="0" Maximum="100" MinWidth="0"
                                                             HorizontalAlignment="Stretch"
                                                             Value="{Binding ProgressPercent}" Height="4" />
                                                <TextBlock Text="{Binding ProgressText}"
                                                           FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource SystemErrorTextColor}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
    </StackPanel>
</UserControl>
