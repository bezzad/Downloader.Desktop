<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:m="clr-namespace:Downloader.Desktop.Models"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             xmlns:v="clr-namespace:Downloader.Desktop.Views"
             xmlns:conv="clr-namespace:Downloader.Desktop.Converters"
             xmlns:services="clr-namespace:Downloader.Desktop.Services"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="Downloader.Desktop.Views.SchedulerView"
             x:DataType="vm:SchedulerViewModel">

    <!-- HorizontalScrollBarVisibility=Disabled keeps the cards within the viewport width (they otherwise
         overflow behind the window when it's narrower than the panel); the page padding lives on the inner
         StackPanel margin (not ScrollViewer.Padding) so the bottom gap is part of the scrollable extent and
         the last card is fully reachable at scroll end. Mirrors the QueuesView fix. -->
    <!-- Sticky page header (#7): title + New-schedule stay pinned while the cards scroll. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28 22 28 8">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{i18n:Tr Sched_Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{i18n:Tr Sched_Desc}"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="accent" Content="{i18n:Tr Sched_Add}" Padding="14 8"
                    VerticalAlignment="Center" Command="{Binding NewScheduleCommand}" />
        </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="28 8 28 22">
            <ItemsControl ItemsSource="{Binding Schedules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleRowViewModel">
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                             CornerRadius="6" VerticalContentAlignment="Center" MaxWidth="280"
                                             HorizontalAlignment="Left" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}"
                                                  OffContent="{i18n:Tr Sched_Off}" OnContent="{i18n:Tr Sched_On}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{i18n:Tr Sched_DeleteTip}" Margin="6 0 0 0">
                                        <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                    </Button>
                                </Grid>

                                <!-- Centered: the dial (the window at a glance), the exact times, then the
                                     queue settings. WrapPanel stacks them when the window is narrow. -->
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Panel Width="220" Height="220" Margin="0 0 32 8">
                                        <v:TimeRangeDial StartTime="{Binding StartTime}" StopTime="{Binding StopTime}"
                                                         TrackBrush="{DynamicResource SystemBaseLowColor}"
                                                         ArcBrush="{DynamicResource SystemAccentColor}"
                                                         HandleRingBrush="{DynamicResource SystemRegionColor}"
                                                         TickBrush="{DynamicResource SystemBaseMediumColor}"
                                                         ToolTip.Tip="{i18n:Tr Sched_DialTip}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsHitTestVisible="False" Spacing="2">
                                            <TextBlock Text="{Binding RangeText}" FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock FontSize="12" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static conv:ScheduleWindowConverter.Instance}">
                                                        <Binding Path="StartTime" />
                                                        <Binding Path="StopTime" />
                                                        <Binding Path="Tick" Source="{x:Static services:Localizer.Instance}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Panel>

                                    <StackPanel Spacing="14" VerticalAlignment="Center" MinWidth="150" Margin="0 0 32 8">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{DynamicResource SystemAccentColor}" />
                                                <TextBlock Text="{i18n:Tr Sched_Start}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StartText}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" StrokeThickness="2"
                                                         Stroke="{DynamicResource SystemAccentColor}" />
                                                <TextBlock Text="{i18n:Tr Sched_Stop}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StopText}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding HasStopTime}" Content="{i18n:Tr Sched_StopAtTime}" />
                                    </StackPanel>

                                    <StackPanel Spacing="14" VerticalAlignment="Center" Margin="0 0 0 8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{i18n:Tr Sched_Queue}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            <ComboBox ItemsSource="{Binding QueueOptions}"
                                                      SelectedItem="{Binding SelectedQueue}" Width="200">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="m:DownloadQueue">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{i18n:Tr Sched_Once}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                            <ToggleSwitch IsChecked="{Binding Once}" OffContent="{i18n:Tr Sched_OnceOff}" OnContent="{i18n:Tr Sched_OnceOn}" />
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
