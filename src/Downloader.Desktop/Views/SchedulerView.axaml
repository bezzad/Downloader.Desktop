<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:m="clr-namespace:Downloader.Desktop.Models"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="Downloader.Desktop.Views.SchedulerView"
             x:DataType="vm:SchedulerViewModel">

    <!-- HorizontalScrollBarVisibility=Disabled keeps the cards within the viewport width (they otherwise
         overflow behind the window when it's narrower than the panel); the page padding lives on the inner
         StackPanel margin (not ScrollViewer.Padding) so the bottom gap is part of the scrollable extent and
         the last card is fully reachable at scroll end. Mirrors the QueuesView fix. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="28 22">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{i18n:Tr Sched_Title}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{i18n:Tr Sched_Desc}"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="{i18n:Tr Sched_Add}" Padding="14 8"
                        VerticalAlignment="Center" Command="{Binding NewScheduleCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Schedules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleRowViewModel">
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                             CornerRadius="6" VerticalContentAlignment="Center" MaxWidth="280"
                                             HorizontalAlignment="Left" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}"
                                                  OffContent="{i18n:Tr Sched_Off}" OnContent="{i18n:Tr Sched_On}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{i18n:Tr Sched_DeleteTip}" Margin="6 0 0 0">
                                        <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                    </Button>
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Spacing="3" Margin="0 0 18 8">
                                        <TextBlock Text="{i18n:Tr Sched_Start}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        <TimePicker SelectedTime="{Binding StartTime}" ClockIdentifier="24HourClock" />
                                    </StackPanel>
                                    <StackPanel Spacing="3" Margin="0 0 18 8">
                                        <TextBlock Text="{i18n:Tr Sched_StopOptional}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        <TimePicker SelectedTime="{Binding StopTime}" ClockIdentifier="24HourClock" />
                                    </StackPanel>
                                    <StackPanel Spacing="3" Margin="0 0 18 8">
                                        <TextBlock Text="{i18n:Tr Sched_Queue}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        <ComboBox ItemsSource="{Binding QueueOptions}"
                                                  SelectedItem="{Binding SelectedQueue}" Width="200">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="m:DownloadQueue">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="3" Margin="0 0 0 8" VerticalAlignment="Bottom">
                                        <TextBlock Text="{i18n:Tr Sched_Once}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        <ToggleSwitch IsChecked="{Binding Once}" OffContent="{i18n:Tr Sched_OnceOff}" OnContent="{i18n:Tr Sched_OnceOn}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
