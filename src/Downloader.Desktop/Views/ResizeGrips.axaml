<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Downloader.Desktop.Views.ResizeGrips">
    <!-- Thin transparent edge/corner strips that drive native resize on a borderless (SystemDecorations=None)
         window. The center cell has no background so all content clicks pass straight through. -->
    <Grid RowDefinitions="6,*,6" ColumnDefinitions="6,*,6"
          PointerMoved="OnMoved" PointerReleased="OnReleased">
        <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="NorthWest" Cursor="TopLeftCorner" PointerPressed="OnPressed" />
        <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="North"     Cursor="SizeNorthSouth" PointerPressed="OnPressed" />
        <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="NorthEast" Cursor="TopRightCorner" PointerPressed="OnPressed" />
        <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="West"      Cursor="SizeWestEast" PointerPressed="OnPressed" />
        <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="East"      Cursor="SizeWestEast" PointerPressed="OnPressed" />
        <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="SouthWest" Cursor="BottomLeftCorner" PointerPressed="OnPressed" />
        <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="South"     Cursor="SizeNorthSouth" PointerPressed="OnPressed" />
        <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="SouthEast" Cursor="BottomRightCorner" PointerPressed="OnPressed" />
    </Grid>
</UserControl>
