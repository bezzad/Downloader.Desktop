<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="Downloader.Desktop.Views.QueuesView"
             x:DataType="vm:QueuesViewModel">
    <StackPanel Margin="28 22" Spacing="8">
        <TextBlock Text="Queues" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Group downloads and control how many run at once."
                   Foreground="{DynamicResource SystemBaseMediumColor}" />
    </StackPanel>
</UserControl>
