<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:conv="clr-namespace:Downloader.Desktop.Converters"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="Downloader.Desktop.Views.QueuesView"
             x:DataType="vm:QueuesViewModel">

    <!-- HorizontalScrollBarVisibility=Disabled constrains content to the viewport width (the cards no
         longer overflow behind the window when it's narrow). The page padding lives on the inner
         StackPanel margin (not ScrollViewer.Padding) so the bottom gap is part of the scrollable extent
         and the last queue row is fully reachable at scroll end. -->
    <!-- Sticky page header (#7): title + actions stay pinned while the queue cards scroll. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28 22 28 8">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{i18n:Tr Queues_Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{i18n:Tr Queues_Desc}"
                           Foreground="{DynamicResource SystemBaseMediumColor}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <!-- Collapse/expand every queue card (#10) — checked = all collapsed -->
                <ToggleButton IsChecked="{Binding AllCollapsed, Mode=TwoWay}" Padding="12 8"
                              Content="{i18n:Tr Queues_CollapseAll}" ToolTip.Tip="{i18n:Tr Queues_CollapseAllTip}" />
                <Button Classes="accent" Content="{i18n:Tr Queues_Add}" Padding="14 8"
                        Command="{Binding NewQueueCommand}" />
            </StackPanel>
        </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="28 8 28 22">
            <ItemsControl ItemsSource="{Binding Queues}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueRowViewModel">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <!-- Header (#8): controls grouped by function with breathing room + thin
                                     dividers, so what's clickable reads at a glance — chevron | name |
                                     [cap group] | [run toggle] | [delete]. -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                                    <!-- Fold/unfold this queue's list (#10); header stays visible when collapsed -->
                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  Classes="icon" Margin="0 0 8 0" ToolTip.Tip="{i18n:Tr Queues_CollapseTip}">
                                        <Panel>
                                            <PathIcon Data="{DynamicResource ChevronUpRegular}" Height="12" Width="12"
                                                      IsVisible="{Binding IsExpanded}" />
                                            <PathIcon Data="{DynamicResource ChevronDownRegular}" Height="12" Width="12"
                                                      IsVisible="{Binding !IsExpanded}" />
                                        </Panel>
                                    </ToggleButton>
                                    <TextBox Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                             CornerRadius="6" VerticalContentAlignment="Center" MaxWidth="280"
                                             HorizontalAlignment="Left" ToolTip.Tip="{i18n:Tr Queues_Name}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16 0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{i18n:Tr Queues_RunSameTime}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                                        <NumericUpDown Value="{Binding MaxConcurrent}" Minimum="1" Maximum="20" Increment="1"
                                                       FormatString="N0" Width="110" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Height="22" Margin="0 0 16 0"
                                            Background="{DynamicResource SystemBaseLowColor}" />
                                    <ToggleSwitch Grid.Column="4" IsChecked="{Binding IsRunning}"
                                                  OffContent="{i18n:Tr Queues_Paused}" OnContent="{i18n:Tr Queues_Running}"
                                                  VerticalAlignment="Center" ToolTip.Tip="{i18n:Tr Queues_ToggleTip}" />
                                    <Border Grid.Column="5" Width="1" Height="22" Margin="16 0"
                                            Background="{DynamicResource SystemBaseLowColor}" />
                                    <Button Grid.Column="6" Classes="icon" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{i18n:Tr Queues_DeleteTip}">
                                        <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                    </Button>
                                </Grid>

                                <!-- Aggregate summary + combined progress -->
                                <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress}" Height="6"
                                             IsVisible="{Binding HasItems}" />

                                <!-- Items (hidden while the card is collapsed — header + stats stay visible) -->
                                <Border Background="{DynamicResource SystemListLowColor}" CornerRadius="8" Padding="12 6"
                                        IsVisible="{Binding IsExpanded}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{i18n:Tr Queues_Empty}" IsVisible="{Binding IsEmpty}"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}" Margin="0 4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QueueItemViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0 5" VerticalAlignment="Center">
                                                        <PathIcon Grid.Column="0" Height="15" Width="15" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource SystemAccentColor}"
                                                                  Data="{Binding Item.FileKind, Converter={x:Static conv:FileKindToIconConverter.Instance}}" />

                                                        <StackPanel Grid.Column="1" Margin="10 0" Spacing="3" VerticalAlignment="Center">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Item.DisplayName}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Item.StatusText}" Margin="8 0 0 0"
                                                                           FontSize="11" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                                                            </Grid>
                                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Item.Progress}" Height="4" />
                                                        </StackPanel>

                                                        <!-- Reorder priority -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6 0 0 0">
                                                            <Button Classes="icon" Command="{Binding MoveUpCommand}" ToolTip.Tip="{i18n:Tr Queues_MoveUp}">
                                                                <PathIcon Data="{DynamicResource ChevronUpRegular}" Height="12" Width="12" />
                                                            </Button>
                                                            <Button Classes="icon" Command="{Binding MoveDownCommand}" ToolTip.Tip="{i18n:Tr Queues_MoveDown}">
                                                                <PathIcon Data="{DynamicResource ChevronDownRegular}" Height="12" Width="12" />
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Per-item actions -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Classes="icon" Command="{Binding Item.PauseCommand}" IsVisible="{Binding Item.CanPause}"
                                                                    ToolTip.Tip="{i18n:Tr Action_Pause}">
                                                                <PathIcon Data="{DynamicResource PauseRegular}" Height="13" Width="13" />
                                                            </Button>
                                                            <Button Classes="icon" Command="{Binding Item.ResumeCommand}" IsVisible="{Binding Item.CanResume}"
                                                                    ToolTip.Tip="{i18n:Tr Action_Resume}">
                                                                <PathIcon Data="{DynamicResource PlayRegular}" Height="13" Width="13" />
                                                            </Button>
                                                            <Button Classes="icon" Command="{Binding Item.RetryCommand}" IsVisible="{Binding Item.CanRetry}"
                                                                    ToolTip.Tip="{i18n:Tr Action_Retry}">
                                                                <PathIcon Data="{DynamicResource PlayRegular}" Height="13" Width="13" />
                                                            </Button>
                                                            <Button Classes="icon" Command="{Binding Item.CancelCommand}" IsVisible="{Binding Item.IsActive}"
                                                                    ToolTip.Tip="{i18n:Tr Action_Stop}">
                                                                <PathIcon Data="{DynamicResource StopRegular}" Height="13" Width="13" />
                                                            </Button>
                                                            <Button Classes="icon" IsVisible="{Binding CanMoveToOtherQueue}" ToolTip.Tip="{i18n:Tr Queues_MoveTo}">
                                                                <PathIcon Data="{DynamicResource ArrowMoveRegular}" Height="13" Width="13" />
                                                                <Button.Flyout>
                                                                    <MenuFlyout ItemsSource="{Binding MoveTargets}">
                                                                        <MenuFlyout.ItemContainerTheme>
                                                                            <ControlTheme TargetType="MenuItem" x:DataType="vm:QueueMoveTarget"
                                                                                          BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                                <Setter Property="Header" Value="{Binding Name}" />
                                                                                <Setter Property="Command" Value="{Binding Command}" />
                                                                            </ControlTheme>
                                                                        </MenuFlyout.ItemContainerTheme>
                                                                    </MenuFlyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                            <Button Classes="icon" Command="{Binding Item.RemoveCommand}" ToolTip.Tip="{i18n:Tr Action_Remove}">
                                                                <PathIcon Data="{DynamicResource DeleteRegular}" Height="13" Width="13" Foreground="IndianRed" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
