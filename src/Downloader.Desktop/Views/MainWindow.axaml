<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.Desktop.ViewModels"
        xmlns:v="using:Downloader.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
        x:Class="Downloader.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/downloader.png"
        WindowStartupLocation="CenterScreen"
        Width="1000" Height="620" MinWidth="840" MinHeight="500"
        ShowInTaskbar="True"
        FontSize="{StaticResource DefaultFontSize}"
        Title="Downloader">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddDownloadItemCommand, Mode=OneTime}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
        <DataTemplate DataType="vm:QueuesViewModel"><v:QueuesView /></DataTemplate>
        <DataTemplate DataType="vm:SchedulerViewModel"><v:SchedulerView /></DataTemplate>
        <DataTemplate DataType="vm:SettingViewModel"><v:SettingView /></DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- ===== Top bar ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 0 0 1"
                Padding="14 10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="18"
                              Foreground="{DynamicResource SystemAccentColor}" />
                    <TextBlock Text="Downloader" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="22 0" MaxWidth="640">
                    <TextBox Grid.Column="0" Text="{Binding DownloadUrl}"
                             CornerRadius="8" Height="34" VerticalContentAlignment="Center"
                             PlaceholderText="Paste a download link…">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddDownloadItemCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="accent" CornerRadius="8" Height="34"
                            Padding="14 0" Margin="8 0 0 0" Cursor="Hand"
                            Command="{Binding AddDownloadItemCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource AddRegular}" Height="12" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox Grid.Column="2" Width="200" Height="34" Text="{Binding SearchText}"
                         CornerRadius="8" VerticalContentAlignment="Center"
                         PlaceholderText="Search" />
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 1 0 0"
                Padding="14 8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="14"
                              Foreground="{DynamicResource SystemAccentColor}" />
                    <TextBlock Text="{Binding TotalSpeedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="{Binding ActiveCount, StringFormat='{}{0} downloading'}" />
                    <TextBlock Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="{Binding QueuedCount, StringFormat='{}{0} queued'}" />
                    <TextBlock Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="{Binding CompletedCount, StringFormat='{}{0} done'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Left nav rail ===== -->
        <Border DockPanel.Dock="Left" Width="{Binding SidebarWidth}"
                Background="{DynamicResource SystemRegionColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 0 1 0"
                Padding="8 12">
            <DockPanel>
                <Button DockPanel.Dock="Top" Classes="icon" Command="{Binding ToggleSidebarCommand}"
                        HorizontalAlignment="Left" Margin="4 0 0 8" ToolTip.Tip="Collapse / expand menu">
                    <PathIcon Data="{StaticResource MenuRegular}" />
                </Button>

                <StackPanel Spacing="1">
                    <TextBlock Classes="section" Text="STATUS" IsVisible="{Binding IsSidebarExpanded}" />

                    <Button Classes="nav" Classes.selected="{Binding IsAllSelected}" Command="{Binding ShowAllCommand}"
                            ToolTip.Tip="All downloads">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource ListRegular}" />
                            <TextBlock Grid.Column="1" Text="All downloads" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding AllCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsActiveSelected}" Command="{Binding ShowActiveCommand}"
                            ToolTip.Tip="Active">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource ArrowDownloadRegular}" />
                            <TextBlock Grid.Column="1" Text="Active" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding ActiveFilterCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsCompletedSelected}" Command="{Binding ShowCompletedCommand}"
                            ToolTip.Tip="Completed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource CheckmarkRegular}" />
                            <TextBlock Grid.Column="1" Text="Completed" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding CompletedFilterCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsFailedSelected}" Command="{Binding ShowFailedCommand}"
                            ToolTip.Tip="Failed / stopped">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource WarningRegular}" />
                            <TextBlock Grid.Column="1" Text="Failed / stopped" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding FailedFilterCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Classes="section" Text="MANAGE" Margin="4 16 0 2" IsVisible="{Binding IsSidebarExpanded}" />
                    <Separator Margin="6 10" IsVisible="{Binding !IsSidebarExpanded}" />

                    <Button Classes="nav" Classes.selected="{Binding IsQueuesSelected}" Command="{Binding ShowQueuesCommand}"
                            ToolTip.Tip="Queues">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource TabsRegular}" />
                            <TextBlock Text="Queues" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsSchedulerSelected}" Command="{Binding ShowSchedulerCommand}"
                            ToolTip.Tip="Scheduler">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource ClockRegular}" />
                            <TextBlock Text="Scheduler" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsSettingsSelected}" Command="{Binding ShowSettingViewCommand}"
                            ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SettingsRegular}" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Central content ===== -->
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
