<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.Desktop.ViewModels"
        xmlns:v="using:Downloader.Desktop.Views"
        xmlns:i18n="using:Downloader.Desktop.Markup"
        xmlns:services="using:Downloader.Desktop.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
        x:Class="Downloader.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/downloader.png"
        WindowStartupLocation="CenterScreen"
        Width="1000" Height="620" MinWidth="840" MinHeight="500"
        ShowInTaskbar="True"
        FontSize="{StaticResource DefaultFontSize}"
        WindowDecorations="None"
        FlowDirection="{Binding FlowDirection, Source={x:Static services:Localizer.Instance}}"
        Title="Downloader">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddDownloadItemCommand, Mode=OneTime}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
        <DataTemplate DataType="vm:QueuesViewModel"><v:QueuesView /></DataTemplate>
        <DataTemplate DataType="vm:SchedulerViewModel"><v:SchedulerView /></DataTemplate>
        <DataTemplate DataType="vm:SettingViewModel"><v:SettingView /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
    <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1">
    <DockPanel>
        <!-- ===== Custom window title bar ===== -->
        <v:TitleBar DockPanel.Dock="Top" Title="Downloader" ShowMinMax="True" />

        <!-- ===== Top bar ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 0 0 1"
                Padding="14 10">
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0 0 22 0" MaxWidth="640"
                      HorizontalAlignment="Left" MinWidth="420">
                    <!-- AcceptsReturn so pasting multiple URLs (one per line) keeps the line breaks;
                         a single-line box would strip them and merge the URLs (#2). Enter still triggers
                         Add (handled in code-behind); Shift+Enter inserts a new line. -->
                    <TextBox Grid.Column="0" Text="{Binding DownloadUrl}"
                             CornerRadius="8" Height="34" VerticalContentAlignment="Center"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             KeyDown="OnUrlBoxKeyDown"
                             PlaceholderText="{i18n:Tr Top_PasteLink}" />
                    <Button Grid.Column="1" Classes="accent" CornerRadius="8" Height="34"
                            Padding="14 0" Margin="8 0 0 0" Cursor="Hand"
                            Command="{Binding AddDownloadItemCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource AddRegular}" Height="12" />
                            <TextBlock Text="{i18n:Tr Top_Add}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox Grid.Column="1" Width="200" Height="34" Text="{Binding SearchText}"
                         HorizontalAlignment="Right"
                         CornerRadius="8" VerticalContentAlignment="Center"
                         PlaceholderText="{i18n:Tr Top_Search}" />
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 1 0 0"
                Padding="14 8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="14"
                              Foreground="{DynamicResource SystemAccentColor}" />
                    <TextBlock Text="{Binding TotalSpeedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding ActiveCount}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock Text="{i18n:Tr Status_Downloading}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding QueuedCount}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock Text="{i18n:Tr Status_Queued}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <TextBlock Text="{i18n:Tr Status_Done}" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Left nav rail ===== -->
        <Border DockPanel.Dock="Left" Width="{Binding SidebarWidth}"
                Background="{DynamicResource SystemRegionColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 0 1 0"
                Padding="8 12">
            <DockPanel>
                <Button DockPanel.Dock="Top" Classes="icon" Command="{Binding ToggleSidebarCommand}"
                        HorizontalAlignment="Left" Margin="4 0 0 8" ToolTip.Tip="{i18n:Tr Nav_ToggleMenu}">
                    <PathIcon Data="{StaticResource MenuRegular}" />
                </Button>

                <StackPanel Spacing="1">
                    <TextBlock Classes="section" Text="{i18n:Tr Nav_Status}" IsVisible="{Binding IsSidebarExpanded}" />

                    <Button Classes="nav" Classes.selected="{Binding IsAllSelected}" Command="{Binding ShowAllCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_AllDownloads}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource AppsListRegular}" />
                            <TextBlock Grid.Column="1" Text="{i18n:Tr Nav_AllDownloads}" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding AllCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsActiveSelected}" Command="{Binding ShowActiveCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_Active}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource ArrowDownloadRegular}" />
                            <TextBlock Grid.Column="1" Text="{i18n:Tr Nav_Active}" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding ActiveFilterCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsCompletedSelected}" Command="{Binding ShowCompletedCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_Completed}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource CheckmarkRegular}" />
                            <TextBlock Grid.Column="1" Text="{i18n:Tr Nav_Completed}" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding CompletedFilterCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsFailedSelected}" Command="{Binding ShowFailedCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_Failed}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource WarningRegular}" />
                            <TextBlock Grid.Column="1" Text="{i18n:Tr Nav_Failed}" VerticalAlignment="Center" Margin="10 0 0 0"
                                       IsVisible="{Binding IsSidebarExpanded}" />
                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding FailedFilterCount}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Classes="section" Text="{i18n:Tr Nav_Manage}" Margin="4 16 0 2" IsVisible="{Binding IsSidebarExpanded}" />
                    <Separator Margin="6 10" IsVisible="{Binding !IsSidebarExpanded}" />

                    <Button Classes="nav" Classes.selected="{Binding IsQueuesSelected}" Command="{Binding ShowQueuesCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_Queues}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource TabsRegular}" />
                            <TextBlock Text="{i18n:Tr Nav_Queues}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsSchedulerSelected}" Command="{Binding ShowSchedulerCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_Scheduler}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource ClockRegular}" />
                            <TextBlock Text="{i18n:Tr Nav_Scheduler}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.selected="{Binding IsSettingsSelected}" Command="{Binding ShowSettingViewCommand}"
                            ToolTip.Tip="{i18n:Tr Nav_Settings}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource SettingsRegular}" />
                            <TextBlock Text="{i18n:Tr Nav_Settings}" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Central content ===== -->
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
    </Border>
    <v:ResizeGrips />
    </Panel>
</Window>
