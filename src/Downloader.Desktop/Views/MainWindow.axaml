<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.Desktop.ViewModels"
        xmlns:v="using:Downloader.Desktop.Views"
        xmlns:i18n="using:Downloader.Desktop.Markup"
        xmlns:services="using:Downloader.Desktop.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
        x:Class="Downloader.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/downloader.png"
        WindowStartupLocation="CenterScreen"
        Width="1000" Height="620" MinWidth="840" MinHeight="500"
        ShowInTaskbar="True"
        FontSize="{StaticResource DefaultFontSize}"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FlowDirection="{Binding FlowDirection, Source={x:Static services:Localizer.Instance}}"
        Title="Downloader">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddDownloadItemCommand, Mode=OneTime}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Footer status pills double as the downloads filter: click one to filter the list to that
             state, "all" clears it. The active filter is highlighted (.active). -->
        <Style Selector="Button.filterpill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9 4" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
        </Style>
        <Style Selector="Button.filterpill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListLowColor}" />
        </Style>
        <Style Selector="Button.filterpill.active">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.filterpill.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.filterpill.active TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
        <DataTemplate DataType="vm:QueuesViewModel"><v:QueuesView /></DataTemplate>
        <DataTemplate DataType="vm:SchedulerViewModel"><v:SchedulerView /></DataTemplate>
        <DataTemplate DataType="vm:SettingViewModel"><v:SettingView /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
    <!-- Rounded window: transparent window + clipped rounded root border (#11) -->
    <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
            CornerRadius="10" ClipToBounds="True"
            Background="{DynamicResource SystemRegionColor}">
    <DockPanel>
        <!-- ===== Custom window title bar ===== -->
        <v:TitleBar DockPanel.Dock="Top" Title="Downloader" ShowMinMax="True" />

        <!-- ===== Top bar ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 0 0 1"
                Padding="14 10">
            <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0 0 22 0" MaxWidth="640"
                      HorizontalAlignment="Left" MinWidth="420">
                    <!-- AcceptsReturn so pasting multiple URLs (one per line) keeps the line breaks;
                         a single-line box would strip them and merge the URLs (#2). Enter still triggers
                         Add (handled in code-behind); Shift+Enter inserts a new line. -->
                    <TextBox Grid.Column="0" Text="{Binding DownloadUrl}"
                             CornerRadius="8" Height="34" VerticalContentAlignment="Center"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             KeyDown="OnUrlBoxKeyDown"
                             PlaceholderText="{i18n:Tr Top_PasteLink}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource LinkRegular}" Height="14" Width="14"
                                      Margin="9 0 2 0" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Classes="accent" CornerRadius="8" Height="34"
                            Padding="14 0" Margin="8 0 0 0" Cursor="Hand"
                            Command="{Binding AddDownloadItemCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource AddRegular}" Height="12" />
                            <TextBlock Text="{i18n:Tr Top_Add}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <TextBox Width="200" Height="34" Text="{Binding SearchText}"
                             CornerRadius="8" VerticalContentAlignment="Center"
                             PlaceholderText="{i18n:Tr Top_Search}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource SearchRegular}" Height="14" Width="14"
                                      Margin="9 0 2 0" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <!-- "Update Downloader" appears once a new version is downloaded and ready (#update). -->
                    <Button Classes="accent" IsVisible="{Binding IsUpdateReady}" Command="{Binding ApplyUpdateCommand}"
                            CornerRadius="8" Height="34" Padding="12 0" Cursor="Hand"
                            ToolTip.Tip="{i18n:Tr Update_Ready_Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="13" />
                            <TextBlock Text="{i18n:Tr Update_Button}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" Command="{Binding DonateCommand}" ToolTip.Tip="{i18n:Tr About_Donate}">
                        <PathIcon Data="{StaticResource HeartRegular}" Foreground="#E5594F" />
                    </Button>
                    <Button Classes="icon" Command="{Binding ShowAboutCommand}" ToolTip.Tip="{i18n:Tr About_Title}">
                        <PathIcon Data="{StaticResource InfoRegular}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Action toolbar (visible on every page) =====
             First group acts on the selected downloads rows (disabled when nothing is checked);
             the queue group is selection-independent; the last group navigates between the
             in-window pages (Downloads / Queues / Scheduler / Settings — current one highlighted). -->
        <Border DockPanel.Dock="Top" Padding="5 4"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="tool" Command="{Binding Downloads.StartSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Start}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource PlayRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_Start}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding Downloads.PauseSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Pause}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource PauseRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_Pause}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding Downloads.StopSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Stop}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource StopRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_Stop}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding Downloads.RemoveSelectedCommand}" ToolTip.Tip="{i18n:Tr Action_Remove}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource DeleteRegular}" HorizontalAlignment="Center" Foreground="#E5594F" />
                        <TextBlock Text="{i18n:Tr Action_Remove}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="6 6" Background="{DynamicResource SystemBaseLowColor}" />

                <!-- Start a whole queue (selection-independent): pick which queue from the dropdown -->
                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Action_StartQueue}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding Downloads.StartQueueTargets}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" x:DataType="vm:QueueActionTarget"
                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource PlayStackRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_StartQueue}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Stop a whole queue (selection-independent): pick which queue from the dropdown -->
                <Button Classes="tool" ToolTip.Tip="{i18n:Tr Action_StopQueue}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding Downloads.StopQueueTargets}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" x:DataType="vm:QueueActionTarget"
                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource StopStackRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_StopQueue}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Stop every item, regardless of queue or selection -->
                <Button Classes="tool" Command="{Binding Downloads.StopAllCommand}" ToolTip.Tip="{i18n:Tr Action_StopAll}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource StopAllRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Action_StopAll}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="6 6" Background="{DynamicResource SystemBaseLowColor}" />

                <!-- Page navigation: back to the downloads list (icon-only), Queues, Scheduler, Settings -->
                <Button Classes="tool" Classes.selected="{Binding IsDownloadsSelected}"
                        Command="{Binding ShowDownloadsCommand}" ToolTip.Tip="{i18n:Tr Nav_Downloads}">
                    <PathIcon Data="{DynamicResource AppsListRegular}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Button>
                <Button Classes="tool" Classes.selected="{Binding IsQueuesSelected}"
                        Command="{Binding ShowQueuesCommand}" ToolTip.Tip="{i18n:Tr Nav_Queues}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource TabsRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Nav_Queues}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Classes.selected="{Binding IsSchedulerSelected}"
                        Command="{Binding ShowSchedulerCommand}" ToolTip.Tip="{i18n:Tr Nav_Scheduler}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource ClockRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Nav_Scheduler}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Classes.selected="{Binding IsSettingsSelected}"
                        Command="{Binding ShowSettingViewCommand}" ToolTip.Tip="{i18n:Tr Nav_Settings}">
                    <StackPanel Orientation="Vertical" Spacing="3">
                        <PathIcon Data="{DynamicResource SettingsRegular}" HorizontalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Nav_Settings}" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0 1 0 0"
                Padding="14 8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="14"
                              Foreground="{DynamicResource SystemAccentColor}" />
                    <TextBlock Text="{Binding TotalSpeedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="filterpill" Classes.active="{Binding IsAllSelected}"
                            Command="{Binding ShowAllCommand}" ToolTip.Tip="{i18n:Tr Status_All}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding AllCount}" />
                            <TextBlock Text="{i18n:Tr Status_All}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="filterpill" Classes.active="{Binding IsActiveSelected}"
                            Command="{Binding ShowActiveCommand}" ToolTip.Tip="{i18n:Tr Status_Downloading}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding ActiveFilterCount}" />
                            <TextBlock Text="{i18n:Tr Status_Downloading}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="filterpill" Classes.active="{Binding IsQueuedSelected}"
                            Command="{Binding ShowQueuedCommand}" ToolTip.Tip="{i18n:Tr Status_Queued}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding QueuedFilterCount}" />
                            <TextBlock Text="{i18n:Tr Status_Queued}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="filterpill" Classes.active="{Binding IsCompletedSelected}"
                            Command="{Binding ShowCompletedCommand}" ToolTip.Tip="{i18n:Tr Status_Done}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding CompletedFilterCount}" />
                            <TextBlock Text="{i18n:Tr Status_Done}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="filterpill" Classes.active="{Binding IsFailedSelected}"
                            Command="{Binding ShowFailedCommand}" ToolTip.Tip="{i18n:Tr Status_Failed}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding FailedFilterCount}" />
                            <TextBlock Text="{i18n:Tr Status_Failed}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Central content: the downloads list or a management page (see the nav buttons) ===== -->
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
    </Border>
    <v:ResizeGrips />
    </Panel>
</Window>
