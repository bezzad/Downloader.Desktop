<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Downloader.Desktop.Views.TitleBar"
             x:Name="Root">
    <UserControl.Styles>
        <!-- Caption (window control) buttons -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerColor}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Button.caption Path">
            <Setter Property="Stroke" Value="{DynamicResource SystemBaseHighColor}" />
            <Setter Property="StrokeThickness" Value="1.2" />
        </Style>
    </UserControl.Styles>

    <!-- The whole bar is the drag region; double-tap toggles maximize. Controls placed in
         RightContent (TextBox, Buttons) mark their own press handled, so they never start a drag. -->
    <Grid x:Name="Bar" ColumnDefinitions="Auto,*,Auto,Auto" Height="42" Margin="1"
          Background="{DynamicResource SystemChromeLowColor}"
          PointerPressed="OnDrag" DoubleTapped="OnToggleMaximize">

        <!-- Icon + title live in the star column and the title ellipsizes, so a long title (e.g.
             a file name in the details window) can never push the caption buttons off-window.
             A horizontal StackPanel would give the text unbounded width — keep this a Grid. -->
        <Grid x:Name="Left" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*"
              Margin="10 0 8 0" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Image Source="/Assets/downloader.png" Width="26" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Grid.Column="1" Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Foreground="{DynamicResource SystemBaseHighColor}"
                       FontSize="15" VerticalAlignment="Center" Margin="10 0 0 0"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       IsVisible="{Binding !CenterTitle, ElementName=Root}"
                       ToolTip.Tip="{Binding Title, ElementName=Root}" />
        </Grid>

        <!-- Centered across the WHOLE bar (not the leftover space); hidden when it would touch
             the right-side content (see TitleFits). -->
        <TextBlock x:Name="CenteredTitle" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Foreground="{DynamicResource SystemBaseHighColor}" FontSize="15"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"
                   IsHitTestVisible="False" Opacity="0" />

        <ContentPresenter x:Name="Right" Grid.Column="2" VerticalAlignment="Center" Margin="0 0 6 0"
                          Content="{Binding RightContent, ElementName=Root}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="caption" Click="OnMinimize" IsVisible="{Binding ShowMinMax, ElementName=Root}"
                    ToolTip.Tip="Minimize">
                <Path Data="M 0,0 H 11" />
            </Button>
            <Button Classes="caption" Click="OnToggleMaximize" IsVisible="{Binding ShowMinMax, ElementName=Root}"
                    ToolTip.Tip="Maximize">
                <Path Data="M 0,0 H 10 V 10 H 0 Z" />
            </Button>
            <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
