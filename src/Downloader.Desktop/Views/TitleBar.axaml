<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Downloader.Desktop.Views.TitleBar"
             x:Name="Root">
    <UserControl.Styles>
        <!-- Caption (window control) buttons -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerColor}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Button.caption Path">
            <Setter Property="Stroke" Value="{DynamicResource SystemBaseHighColor}" />
            <Setter Property="StrokeThickness" Value="1.2" />
        </Style>
    </UserControl.Styles>

    <!-- The whole bar is the drag region; double-tap toggles maximize -->
    <Grid ColumnDefinitions="Auto,*,Auto" Height="42"
          Background="{DynamicResource SystemChromeLowColor}"
          PointerPressed="OnDrag" DoubleTapped="OnToggleMaximize">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    Margin="14 0 0 0" VerticalAlignment="Center">
            <Image Source="/Assets/downloader.png" Width="26" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold"
                       FontSize="15" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="caption" Click="OnMinimize" IsVisible="{Binding ShowMinMax, ElementName=Root}"
                    ToolTip.Tip="Minimize">
                <Path Data="M 0,0 H 11" />
            </Button>
            <Button Classes="caption" Click="OnToggleMaximize" IsVisible="{Binding ShowMinMax, ElementName=Root}"
                    ToolTip.Tip="Maximize">
                <Path Data="M 0,0 H 10 V 10 H 0 Z" />
            </Button>
            <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
