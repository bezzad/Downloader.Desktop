<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="Downloader.Desktop.Views.SettingView"
             x:DataType="vm:SettingViewModel">

    <ScrollViewer Padding="28 22">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />

            <TextBlock Text="GENERAL" Classes="section" />

            <StackPanel Spacing="6">
                <TextBlock Text="Default save folder" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding DefaultSavePath, Mode=TwoWay}"
                             CornerRadius="6" VerticalContentAlignment="Center"
                             PlaceholderText="Where files are saved" />
                    <Button Grid.Column="1" Margin="8 0 0 0" Padding="10"
                            Command="{Binding SelectSavePathCommand}" ToolTip.Tip="Browse">
                        <PathIcon Data="{StaticResource FolderRegular}" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Default connections (segments)" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding DefaultDownloadSegments}"
                               Increment="1" FormatString="N0" Minimum="1" Maximum="64" Width="120" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Dark theme" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                              Command="{Binding SwitchThemeCommand}"
                              OffContent="Light" OnContent="Dark" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
