<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
             xmlns:services="clr-namespace:Downloader.Desktop.Services"
             xmlns:v="clr-namespace:Downloader.Desktop.Views"
             xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
             x:Class="Downloader.Desktop.Views.SettingView"
             x:DataType="vm:SettingViewModel">

    <UserControl.Styles>
        <Style Selector="Grid.field">
            <Setter Property="Margin" Value="0 7" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Grid.field > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.field StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
            <Setter Property="Margin" Value="0 1 0 0" />
            <!-- Long captions (e.g. the local-API toggle) must wrap, not clip off-window. -->
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Match the NumericUpDown stepper exactly (148 wide, 34 tall) so every right-hand control —
             combo boxes (Language, Accent, File-exists) and text boxes — lines up at one size. -->
        <Style Selector="ComboBox.ctrl, TextBox.ctrl">
            <Setter Property="Width" Value="148" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Compact numeric stepper matching the download-details window (value + arrows, no wide gap) -->
        <Style Selector="NumericUpDown.ctrl">
            <Setter Property="Width" Value="148" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Vertically centered inputs. NumericUpDown is intentionally NOT restyled here so it inherits
             the global, touch-friendly stepper look used by the download-details window. -->
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- Sticky page header (#7): the title row lives OUTSIDE the ScrollViewer so it stays pinned
         while the options scroll. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" MaxWidth="680" Margin="28 22 28 6">
            <TextBlock Grid.Column="0" Text="{i18n:Tr Settings_Title}" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <!-- Search filters the visible options as you type (#15); clearing restores everything. -->
            <TextBox Grid.Column="1" x:Name="SearchBox" Width="190" Margin="0 0 10 0"
                     VerticalAlignment="Center" CornerRadius="6"
                     PlaceholderText="{i18n:Tr Settings_SearchPlaceholder}"
                     TextChanged="OnSearchChanged">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource SearchRegular}" Height="13" Margin="8 0 2 0" Opacity="0.6" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="2" Command="{Binding ResetDefaultsCommand}" Padding="12 7"
                    ToolTip.Tip="{i18n:Tr Settings_ResetTip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource OptionsRegular}" Height="14" />
                    <TextBlock Text="{i18n:Tr Settings_Reset}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

    <ScrollViewer>
        <StackPanel x:Name="SectionsPanel" Spacing="16" MaxWidth="680" Margin="28 6 28 22" HorizontalAlignment="Stretch">

            <!-- ===== General ===== (#16: every section is a collapsible Expander, expanded by default) -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="{i18n:Tr Sec_General}">
                <StackPanel Spacing="2">

                    <Grid Classes="field" ColumnDefinitions="*">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{i18n:Tr Set_DefaultFolder}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding DefaultSavePath, Mode=TwoWay}"
                                         CornerRadius="6" VerticalContentAlignment="Center"
                                         PlaceholderText="{i18n:Tr Set_DefaultFolderPlaceholder}" />
                                <Button Grid.Column="1" Margin="8 0 0 0" Padding="10"
                                        Command="{Binding SelectSavePathCommand}" ToolTip.Tip="{i18n:Tr Tooltip_Browse}">
                                    <PathIcon Data="{StaticResource FolderRegular}" Height="16" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_RememberSavePath}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_RememberSavePath_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RememberLastSavePath}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_Language}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_Language_Hint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Classes="ctrl" ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:LanguageOption">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Image Source="{Binding Flag}" Width="22" Height="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_Connections}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_Connections_Hint}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding ChunkCount}"
                                       Minimum="1" Maximum="64" Increment="1" FormatString="N0" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{i18n:Tr Set_Parallel}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ParallelDownload}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_ParallelParts}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_ParallelParts_Hint}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding ParallelCount}"
                                       Minimum="0" Maximum="64" Increment="1" FormatString="N0" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_MaxSpeed}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_Unlimited_Hint}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MaxSpeedKbPerSecond}"
                                       Minimum="0" Increment="128" FormatString="N0" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_MaxConcurrent}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_PerQueue_Hint}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MaxConcurrentDownloads}"
                                       Minimum="1" Maximum="20" Increment="1" FormatString="N0" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{i18n:Tr Set_DarkTheme}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                      Command="{Binding SwitchThemeCommand}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_Accent}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_Accent_Hint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Classes="ctrl" ItemsSource="{Binding Accents}"
                                  SelectedItem="{Binding SelectedAccent}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:AccentOption">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Ellipse Width="15" Height="15" Fill="{Binding Brush}"
                                                 Stroke="{DynamicResource SystemBaseMediumLowColor}" StrokeThickness="1"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_Notifications}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_Notifications_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNotifications}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== Notifications ===== -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="{i18n:Tr Sec_Notifications}">
                <StackPanel Spacing="2">
                    <!-- The per-event toggles only apply while the master switch (above) is on. -->
                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{i18n:Tr Set_NotifyComplete}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOnComplete}"
                                      IsEnabled="{Binding EnableNotifications}" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{i18n:Tr Set_NotifyFailed}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOnFailed}"
                                      IsEnabled="{Binding EnableNotifications}" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{i18n:Tr Set_NotifyAllComplete}" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOnAllComplete}"
                                      IsEnabled="{Binding EnableNotifications}" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_NotifyShutdown}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_NotifyShutdown_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOnShutdown}"
                                      IsEnabled="{Binding EnableNotifications}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_ShutdownOnComplete}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_ShutdownOnComplete_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShutdownOnCompletion}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== App & updates ===== -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="{i18n:Tr Sec_AppUpdates}">
                <StackPanel Spacing="2">

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_SystemTray}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_SystemTray_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSystemTray}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_Notch}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_Notch_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNotch}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_RunAtStartup}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_RunAtStartup_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtStartup}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_AutoUpdate}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_AutoUpdate_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdate}" />
                    </Grid>

                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_BrowserIntegration}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_BrowserIntegration_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableBrowserIntegration}" />
                    </Grid>

                    <!-- Review downloads handed over by the extension or another local-API tool before
                         they are added, instead of them appearing already running (issue #13). -->
                    <Grid Classes="field" ColumnDefinitions="*,Auto" IsVisible="{Binding EnableBrowserIntegration}">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_ConfirmProgrammaticAdds}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_ConfirmProgrammaticAdds_Hint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmProgrammaticAdds}" />
                    </Grid>

                    <!-- Read-only status: which loopback address the API bound to + a live reachable dot. -->
                    <Grid Classes="field" ColumnDefinitions="*,Auto" IsVisible="{Binding EnableBrowserIntegration}">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_LocalApiStatus}" />
                            <TextBlock Classes="hint" Text="{Binding LocalApiAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{Binding LocalApiStatusBrush}" />
                            <TextBlock Text="{Binding LocalApiStatusText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- The way to actually GET the extension. Without this the only route was the
                         README's developer-mode instructions, which is not something to ask of the
                         non-technical audience this app is for. -->
                    <Grid Classes="field" ColumnDefinitions="*,Auto" IsVisible="{Binding EnableBrowserIntegration}">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Ext_Install_Button}" />
                            <!-- Turns into "out of date — vX is available" when the unpacked copy is
                                 behind the one this app carries, so a stale extension is visible from
                                 Settings instead of only inside the dialog. -->
                            <TextBlock Classes="hint" Text="{Binding ExtensionHintText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ctrl" Content="{i18n:Tr Ext_Install}"
                                Command="{Binding InstallExtensionCommand}" />
                    </Grid>

                    <!-- Check for updates → (downloading: progress) → Restart to update. The label
                         reflects UpdateFlow state; a progress bar shows during the background download. -->
                    <StackPanel Spacing="6" Margin="0 6 0 0">
                        <!-- Shows WHICH version is available (#update). -->
                        <TextBlock Text="{Binding AvailableVersionText}" IsVisible="{Binding HasAvailableVersion}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Padding="12 6" Command="{Binding CheckUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource ArrowDownloadRegular}" Height="14" />
                                    <TextBlock Text="{Binding UpdateButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Download progress + a × to cancel it (#update). -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding IsUpdateDownloading}">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                             Width="150" Height="6" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdateProgressText}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                                <Button Classes="icon" Padding="4" Command="{Binding CancelUpdateDownloadCommand}"
                                        ToolTip.Tip="{i18n:Tr Update_CancelTip}">
                                    <PathIcon Data="{StaticResource DismissRegular}" Height="12" Width="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ===== Plugins — expanded by default (#16) ===== -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="{i18n:Tr Sec_Plugins}">
                <v:PluginsView DataContext="{Binding Plugins}" Margin="2 6" />
            </Expander>

            <!-- ===== Logging ===== -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Header="{i18n:Tr Sec_Logging}">
                <StackPanel Spacing="6">
                    <Grid Classes="field" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:Tr Set_WriteLog}" />
                            <TextBlock Classes="hint" Text="{i18n:Tr Set_WriteLog_Hint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableLogging}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="{i18n:Tr Btn_OpenLogs}" Command="{Binding OpenLogsFolderCommand}" />
                        <Button Classes="secondary" Content="{i18n:Tr Btn_ExportLog}" Command="{Binding ExportLogsCommand}" />
                        <Button Classes="secondary" Content="{i18n:Tr Btn_EmailLogs}" Command="{Binding EmailLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ===== Advanced (incl. network) — expanded by default like every section (#16) ===== -->
            <Expander Header="{i18n:Tr Adv_Header}" HorizontalAlignment="Stretch" IsExpanded="True">
                <StackPanel Spacing="2" Margin="2 6">
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_BufferBlock}" />
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding BufferBlockSize}"
                                           Minimum="1" Maximum="1048576" Increment="1024" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_MaxRetries}" />
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MaxTryAgainOnFailure}"
                                           Minimum="0" Maximum="1000" Increment="1" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_BlockTimeout}" />
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding BlockTimeout}"
                                           Minimum="100" Increment="100" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_HttpTimeout}" />
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding HttpClientTimeout}"
                                           Minimum="1000" Increment="1000" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_MinChunking}" />
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MinimumSizeOfChunking}"
                                           Minimum="0" Increment="256" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_MinChunk}" />
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MinimumChunkSize}"
                                           Minimum="0" Increment="256" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{i18n:Tr Set_MaxMemory}" />
                                <TextBlock Classes="hint" Text="{i18n:Tr Set_Unlimited_Hint}" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MaxMemoryBufferMb}"
                                           Minimum="0" Increment="64" FormatString="N0" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_CheckDisk}" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckDiskSizeBeforeDownload}" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_AutoResume}" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoResumeDownload}" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_ClearOnFail}" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearPackageOnCompletionWithFailure}" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_FileExists}" />
                            <ComboBox Grid.Column="1" Classes="ctrl" ItemsSource="{Binding FileExistPolicies}"
                                      SelectedItem="{Binding SelectedFileExistPolicy}" />
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{i18n:Tr Set_FileExt}" />
                            <TextBox Grid.Column="1" Classes="ctrl" Text="{Binding DownloadFileExtension}" CornerRadius="6" />
                        </Grid>

                        <!-- Network & request headers — a clearly delineated sub-section (#2) -->
                        <Border Margin="0 16 0 2" CornerRadius="8" Padding="14"
                                Background="{DynamicResource SystemRegionColor}"
                                BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource OptionsRegular}" Height="15"
                                          Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{i18n:Tr Net_Header}" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{i18n:Tr Net_Hint}"
                                       Margin="0 0 0 4" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="{i18n:Tr Set_UserAgent}" />
                                <TextBox Text="{Binding UserAgent}" CornerRadius="6" PlaceholderText="Default (Downloader/x.y)" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{i18n:Tr Set_Referer}" />
                                <TextBox Text="{Binding Referer}" CornerRadius="6" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{i18n:Tr Set_Accept}" />
                                <TextBox Text="{Binding Accept}" CornerRadius="6" />
                            </StackPanel>
                            <Grid Classes="field" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{i18n:Tr Set_FollowRedirects}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowAutoRedirect}" />
                            </Grid>
                            <Grid Classes="field" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{i18n:Tr Set_MaxRedirects}" />
                                <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding MaximumAutomaticRedirections}"
                                               Minimum="1" Maximum="100" Increment="1" FormatString="N0" />
                            </Grid>
                            <Grid Classes="field" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{i18n:Tr Set_ConnectTimeout}" />
                                <NumericUpDown Grid.Column="1" Classes="ctrl" Value="{Binding ConnectTimeout}"
                                               Minimum="1000" Increment="1000" FormatString="N0" />
                            </Grid>
                            <Grid Classes="field" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{i18n:Tr Set_KeepAlive}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepAlive}" />
                            </Grid>
                            <!-- Proxy on a single line: label left, box fills the rest (it was a full-width
                                 box stacked under its label, which looked oversized). -->
                            <Grid Classes="field" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{i18n:Tr Set_Proxy}" Margin="0 0 12 0" />
                                <TextBox Grid.Column="1" Text="{Binding ProxyAddress}" CornerRadius="6"
                                         VerticalAlignment="Center" PlaceholderText="{i18n:Tr Set_ProxyPlaceholder}" />
                            </Grid>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

            <!-- ===== About ===== -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Downloader" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" Text="{i18n:Tr About_Desc}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding AppVersion, StringFormat='v{0}'}"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
