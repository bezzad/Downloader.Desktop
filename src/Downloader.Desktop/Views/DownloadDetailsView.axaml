<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="680"
        Width="640" Height="680"
        CanResize="True" MinWidth="520" MinHeight="520"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{DynamicResource ThemeBackgroundColor}"
        x:Class="Downloader.Desktop.Views.DownloadDetailsView"
        x:DataType="vm:DownloadDetailsViewModel"
        WindowStartupLocation="CenterOwner"
        Title="Download details">

    <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding Item.FileName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Source URL (editable when stopped) + copy -->
        <Border Grid.Row="1" Classes="card" Margin="0 12 0 0">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Source URL" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CopyUrlCommand}" ToolTip.Tip="Copy URL">
                        <PathIcon Data="{StaticResource ListRegular}" Height="14" />
                    </Button>
                </Grid>
                <TextBox Text="{Binding EditableUrl, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}"
                         CornerRadius="6" VerticalContentAlignment="Center" />
                <Expander Header="{Binding MirrorsHeader}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6" Margin="0 6 0 0" HorizontalAlignment="Stretch">
                        <TextBlock Text="Extra sources for the same file, used as fallbacks. Editable while the download is stopped."
                                   Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Mirrors}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MirrorEntryViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 6">
                                        <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay}"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:DownloadDetailsViewModel)DataContext).CanEdit}"
                                                 CornerRadius="6" VerticalContentAlignment="Center"
                                                 PlaceholderText="https://mirror/..." />
                                        <Button Grid.Column="1" Classes="icon" Margin="6 0 0 0"
                                                Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this mirror">
                                            <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add mirror" Command="{Binding AddMirrorCommand}"
                                IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" Padding="12 6" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2" Margin="0 12 0 0" CornerRadius="8" Padding="12 10"
                Background="{DynamicResource DangerColor}" IsVisible="{Binding HasError}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource WarningRegular}" Height="16" Foreground="White" VerticalAlignment="Top" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Summary + actions + live speed limit -->
        <Border Grid.Row="3" Classes="card" Margin="0 12 0 0">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Status" Margin="0 0 10 0"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Grid.Column="1" Text="{Binding Item.StatusText}" />
                    <TextBlock Grid.Column="2" Text="{Binding Item.SizeText}" Margin="0 0 10 0"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Grid.Column="3" Text="{Binding Item.SpeedText}" />
                </Grid>

                <!-- Single, merged progress: a fragmented per-connection bar with the overall % below it.
                     Before any connection exists we show a plain bar so there's always an indicator. (#5) -->
                <Border Height="22" CornerRadius="5" ClipToBounds="True"
                        Background="{DynamicResource SystemListLowColor}"
                        BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
                        IsVisible="{Binding HasParts}">
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                             CornerRadius="0" Margin="0 0 1 0"
                                             ToolTip.Tip="{Binding StatusText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Item.Progress}" Height="8"
                             IsVisible="{Binding !HasParts}" />
                <TextBlock Text="{Binding Item.Progress, StringFormat='{}{0:0}%'}" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasConfig}">
                        <TextBlock Text="Speed limit (KB/s)" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <NumericUpDown Value="{Binding SpeedLimitKb}" Minimum="0" Increment="128"
                                       FormatString="N0" Width="140" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon" Command="{Binding Item.PauseCommand}" IsVisible="{Binding Item.CanPause}" ToolTip.Tip="Pause">
                            <PathIcon Data="{DynamicResource PauseRegular}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Item.ResumeCommand}" IsVisible="{Binding Item.CanResume}" ToolTip.Tip="Resume">
                            <PathIcon Data="{DynamicResource PlayRegular}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Item.CancelCommand}" IsVisible="{Binding Item.IsActive}" ToolTip.Tip="Stop">
                            <PathIcon Data="{DynamicResource StopRegular}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Item.OpenFolderCommand}" ToolTip.Tip="Open folder">
                            <PathIcon Data="{DynamicResource FolderRegular}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Connections: just the per-connection grid (the progress bar lives in the summary above, #5) -->
        <Border Grid.Row="4" Classes="card" Margin="0 12 0 0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0 0 0 8">
                    <TextBlock Grid.Column="0" Classes="section" Text="CONNECTIONS" />
                    <TextBlock Grid.Column="1" Text="{Binding PartsSummary}"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                </Grid>

                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasParts}"
                           Text="Connections appear here while the file is downloading."
                           Foreground="{DynamicResource SystemBaseMediumColor}" TextWrapping="Wrap" />

                <DataGrid ItemsSource="{Binding Parts}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" CanUserResizeColumns="True" CanUserSortColumns="False"
                          HeadersVisibility="Column" Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{ReflectionBinding StatusText}" Width="*" />
                        <DataGridTemplateColumn Header="Downloaded" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <TextBlock Text="{Binding DownloadedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Total" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
            <Button Content="Close" Padding="18 7" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
