<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="460"
        Width="560" Height="460"
        CanResize="True" MinWidth="460" MinHeight="360"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{DynamicResource ThemeBackgroundColor}"
        x:Class="Downloader.Desktop.Views.DownloadDetailsView"
        x:DataType="vm:DownloadDetailsViewModel"
        WindowStartupLocation="CenterOwner"
        Title="Download details">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding Item.FileName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Item.Url}" Foreground="{DynamicResource SystemBaseMediumColor}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Summary -->
        <Border Grid.Row="1" Classes="card" Margin="0 14">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" >
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Margin="0 3 16 3"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.StatusText}" Margin="0 3" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Margin="0 3 16 3"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Item.SizeText}" Margin="0 3" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Speed" Margin="0 3 16 3"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Item.SpeedText}" Margin="0 3" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Progress" Margin="0 6 16 3"
                           Foreground="{DynamicResource SystemBaseMediumColor}" VerticalAlignment="Center" />
                <ProgressBar Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100"
                             Value="{Binding Item.Progress}" Height="8" Margin="0 6 0 3" />
            </Grid>
        </Border>

        <!-- Parts -->
        <Border Grid.Row="2" Classes="card">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="section" Text="PARTS" Margin="0 0 0 8" />
                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasParts}"
                           Text="No part information available."
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                <Grid ColumnDefinitions="70,*,90" Margin="0 4">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress}" Height="6"
                                                 VerticalAlignment="Center" Margin="0 0 10 0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="Close" Padding="18 7" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
