<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Downloader.Desktop.ViewModels"
        xmlns:v="clr-namespace:Downloader.Desktop.Views"
        xmlns:i18n="clr-namespace:Downloader.Desktop.Markup"
        xmlns:services="clr-namespace:Downloader.Desktop.Services"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="700"
        Width="640" Height="700"
        CanResize="True" MinWidth="520" MinHeight="520"
        FontSize="{StaticResource DefaultFontSize}"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="/Assets/downloader.png"
        x:Class="Downloader.Desktop.Views.DownloadDetailsView"
        x:DataType="vm:DownloadDetailsViewModel"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding FlowDirection, Source={x:Static services:Localizer.Instance}}"
        Title="{Binding WindowTitle}">

    <Panel>
    <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
            CornerRadius="10" ClipToBounds="True" Background="{DynamicResource SystemRegionColor}">
    <DockPanel>
    <!-- Title bar shows the live "{percent}% {file name}" caption (next to the app icon). -->
    <v:TitleBar DockPanel.Dock="Top" Title="{Binding WindowTitle}" ShowMinMax="False" />
    <Grid Margin="22 18 22 22" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Source URL (editable when stopped) + copy. The file name now lives in the title bar, so
             there's no separate header here (it was redundant with this URL section). -->
        <Border Grid.Row="0" Classes="card">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{i18n:Tr Det_SourceUrl}" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CopyUrlCommand}" ToolTip.Tip="{Binding CopyUrlTooltip}">
                        <Panel>
                            <PathIcon Data="{DynamicResource CopyRegular}" IsVisible="{Binding !UrlCopied}" />
                            <PathIcon Data="{DynamicResource CheckmarkRegular}" Foreground="MediumSeaGreen"
                                      IsVisible="{Binding UrlCopied}" />
                        </Panel>
                    </Button>
                </Grid>
                <TextBox Text="{Binding EditableUrl, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}"
                         CornerRadius="6" VerticalContentAlignment="Center" />
                <Expander Header="{Binding MirrorsHeader}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6" Margin="0 6 0 0" HorizontalAlignment="Stretch">
                        <TextBlock Text="{i18n:Tr Det_Mirrors_Hint}"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Mirrors}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MirrorEntryViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 6">
                                        <TextBox Grid.Column="0" Text="{Binding Url, Mode=TwoWay}"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:DownloadDetailsViewModel)DataContext).CanEdit}"
                                                 CornerRadius="6" VerticalContentAlignment="Center"
                                                 PlaceholderText="{i18n:Tr Det_MirrorPlaceholder}" />
                                        <Button Grid.Column="1" Classes="icon" Margin="6 0 0 0"
                                                Command="{Binding RemoveCommand}" ToolTip.Tip="{i18n:Tr Det_RemoveMirror}">
                                            <PathIcon Data="{DynamicResource DeleteRegular}" Foreground="IndianRed" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{i18n:Tr Det_AddMirror}" Command="{Binding AddMirrorCommand}"
                                IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" Padding="12 6" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Error banner: shows the failure reason with a copy button so it can be pasted into a
             GitHub issue. The message is also selectable for partial copies. -->
        <Border Grid.Row="1" Margin="0 12 0 0" CornerRadius="8" Padding="12 10"
                Background="{DynamicResource DangerColor}" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource WarningRegular}" Height="16"
                          Foreground="White" VerticalAlignment="Top" Margin="0 2 10 0" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="White"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6"
                        CornerRadius="6" Cursor="Hand" Margin="8 0 0 0" VerticalAlignment="Top"
                        Command="{Binding CopyErrorCommand}" ToolTip.Tip="{Binding CopyErrorTooltip}">
                    <Panel>
                        <PathIcon Data="{DynamicResource CopyRegular}" Height="15" Foreground="White"
                                  IsVisible="{Binding !ErrorCopied}" />
                        <PathIcon Data="{DynamicResource CheckmarkRegular}" Height="15" Foreground="White"
                                  IsVisible="{Binding ErrorCopied}" />
                    </Panel>
                </Button>
            </Grid>
        </Border>

        <!-- Summary + actions + live speed limit -->
        <Border Grid.Row="2" Classes="card" Margin="0 12 0 0">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{i18n:Tr Det_Status}" Margin="0 0 10 0"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Grid.Column="1" Text="{Binding Item.StatusText}" />
                    <TextBlock Grid.Column="2" Text="{Binding Item.SizeText}" Margin="0 0 10 0"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Grid.Column="3" Text="{Binding Item.SpeedText}" />
                </Grid>

                <!-- Single, merged progress: a fragmented per-connection bar with the overall % below it.
                     Before any connection exists we show a plain bar so there's always an indicator. (#5) -->
                <Border Height="22" CornerRadius="5" ClipToBounds="True"
                        Background="{DynamicResource SystemListLowColor}"
                        BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
                        IsVisible="{Binding HasParts}">
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                <!-- Plain track + fill (not a themed ProgressBar) so the fill reaches
                                     edge-to-edge at 100% and stretches the full segment height. A 1px
                                     right inset separates adjacent connection segments. -->
                                <Border Background="{DynamicResource SystemListLowColor}" Margin="0 0 1 0"
                                        ToolTip.Tip="{Binding StatusText}">
                                    <!-- Each connection's fill in its own stable color (#7) -->
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                 Foreground="{Binding Brush}"
                                                 CornerRadius="0" Padding="0"
                                                 MinHeight="0" MinWidth="0"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Item.Progress}" Height="8"
                             IsVisible="{Binding !HasParts}" />
                <TextBlock Text="{Binding Item.Progress, StringFormat='{}{0:0}%'}" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />

                <!-- Saved-to path next to the open-folder action (#7) -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 2 0 0">
                    <TextBlock Grid.Column="0" Text="{i18n:Tr Det_SavedTo}" Margin="0 0 8 0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBox Grid.Column="1" Text="{Binding FilePath}" IsReadOnly="True"
                             CornerRadius="6" VerticalContentAlignment="Center"
                             FontSize="12" />
                    <!-- Right of the path box: copy the saved path to the clipboard. The icon flips to a
                         checkmark and the tooltip reads "Path copied!" for a moment as confirmation.
                         Opening the folder is still available via the action button below. -->
                    <Button Grid.Column="2" Classes="icon" Margin="6 0 0 0"
                            Command="{Binding CopyPathCommand}" ToolTip.Tip="{Binding CopyPathTooltip}">
                        <Panel>
                            <PathIcon Data="{DynamicResource CopyRegular}" IsVisible="{Binding !PathCopied}" />
                            <PathIcon Data="{DynamicResource CheckmarkRegular}" Foreground="MediumSeaGreen"
                                      IsVisible="{Binding PathCopied}" />
                        </Panel>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding HasConfig}">
                        <TextBlock Text="{i18n:Tr Det_SpeedLimit}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <NumericUpDown Value="{Binding SpeedLimitKb}" Minimum="0" Increment="128"
                                       FormatString="N0" Width="140" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon" Command="{Binding Item.PauseCommand}" IsVisible="{Binding Item.CanPause}" ToolTip.Tip="{i18n:Tr Action_Pause}">
                            <PathIcon Data="{DynamicResource PauseRegular}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Item.ResumeCommand}" IsVisible="{Binding Item.CanResume}" ToolTip.Tip="{i18n:Tr Action_Resume}">
                            <PathIcon Data="{DynamicResource PlayRegular}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Item.CancelCommand}" IsVisible="{Binding Item.IsActive}" ToolTip.Tip="{i18n:Tr Action_Stop}">
                            <PathIcon Data="{DynamicResource StopRegular}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding Item.OpenFolderCommand}" ToolTip.Tip="{i18n:Tr Action_OpenFolder}">
                            <PathIcon Data="{DynamicResource FolderRegular}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Connections: just the per-connection grid (the progress bar lives in the summary above, #5) -->
        <Border Grid.Row="3" Classes="card" Margin="0 12 0 0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasParts}"
                           Text="{i18n:Tr Det_ConnAppear}"
                           Foreground="{DynamicResource SystemBaseMediumColor}" TextWrapping="Wrap" />

                <DataGrid ItemsSource="{Binding Parts}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" CanUserResizeColumns="True" CanUserSortColumns="False"
                          HeadersVisibility="Column" Background="Transparent"
                          RowHeight="26" BorderThickness="0">
                    <!-- DataGrid.FontSize does NOT cascade to cell/header content in Avalonia, so set it on
                         the actual TextBlocks (rows + headers) to make the connections table compact (#3). -->
                    <DataGrid.Styles>
                        <Style Selector="DataGridCell TextBlock">
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                        <Style Selector="DataGridColumnHeader TextBlock">
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{i18n:Tr Det_Col_Index}" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <TextBlock Text="{Binding Index}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Per-connection progress: a colored bar with the % overlaid, so each
                             chunk's completion is visible at a glance next to its downloaded MB. -->
                        <DataGridTemplateColumn Header="{i18n:Tr Det_Col_Progress}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <Grid VerticalAlignment="Center" Margin="6 0">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                     Foreground="{Binding Brush}" Height="14" CornerRadius="3"
                                                     MinWidth="0" MinHeight="0" Padding="0" />
                                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:0}%'}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{i18n:Tr Det_Col_Status}" Binding="{ReflectionBinding StatusText}" FontSize="11" Width="*" />
                        <DataGridTemplateColumn Header="{i18n:Tr Det_Col_Downloaded}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <TextBlock Text="{Binding DownloadedText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{i18n:Tr Det_Col_Total}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ChunkProgressViewModel">
                                    <TextBlock Text="{Binding TotalText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
            <Button Content="{i18n:Tr Btn_Close}" Padding="18 7" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
    </DockPanel>
    </Border>
    <v:ResizeGrips />
    </Panel>
</Window>
