<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Downloader.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <ResourceDictionary>
            <x:Double x:Key="DefaultFontSize">13</x:Double>
            <x:Double x:Key="H1FontSize">15</x:Double>
            <!-- Status colors (shared across themes) -->
            <SolidColorBrush x:Key="DangerColor" Color="#E5594F" />
            <SolidColorBrush x:Key="SuccessColor" Color="#1FA971" />
            <SolidColorBrush x:Key="WarningColor" Color="#E0922F" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <!-- Ocean-blue / teal palette on softly tinted neutrals -->
                <ColorPaletteResources x:Key="Light" Accent="#0E8FB3" AltHigh="#FFFFFF" AltLow="#FFFFFF" AltMedium="#FFFFFF" AltMediumHigh="#FFFFFF" AltMediumLow="#FFFFFF" BaseHigh="#16242B" BaseLow="#C6D2DA" BaseMedium="#5C6B73" BaseMediumHigh="#3D4C53" BaseMediumLow="#74848B" ChromeAltLow="#3D4C53" ChromeBlackHigh="#000000" ChromeBlackLow="#C6D2DA" ChromeBlackMedium="#3D4C53" ChromeBlackMediumLow="#5C6B73" ChromeDisabledHigh="#E1E8EC" ChromeDisabledLow="#9AA8AF" ChromeGray="#74848B" ChromeHigh="#C6D2DA" ChromeLow="#FFFFFF" ChromeMedium="#E8EEF1" ChromeMediumLow="#EFF4F6" ChromeWhite="#FFFFFF" ListLow="#E7EEF2" ListMedium="#D8E2E8" RegionColor="#E9EFF3" />
                <ColorPaletteResources x:Key="Dark" Accent="#2DBED6" AltHigh="#15202A" AltLow="#15202A" AltMedium="#15202A" AltMediumHigh="#15202A" AltMediumLow="#15202A" BaseHigh="#EAF1F4" BaseLow="#283642" BaseMedium="#93A4AD" BaseMediumHigh="#B4C2C9" BaseMediumLow="#6B7A83" ChromeAltLow="#B4C2C9" ChromeBlackHigh="#000000" ChromeBlackLow="#B4C2C9" ChromeBlackMedium="#000000" ChromeBlackMediumLow="#000000" ChromeDisabledHigh="#283642" ChromeDisabledLow="#93A4AD" ChromeGray="#808E97" ChromeHigh="#808E97" ChromeLow="#0F1822" ChromeMedium="#1B2833" ChromeMediumLow="#243240" ChromeWhite="#FFFFFF" ListLow="#1B2833" ListMedium="#243240" RegionColor="#0B121A" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <StyleInclude Source="avares://Downloader.Desktop/Assets/Icons.axaml" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ============ Custom modern styles ============ -->

        <!-- Section header in sidebar / settings -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
            <Setter Property="Margin" Value="4 6 0 2" />
        </Style>

        <!-- Card container -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemAltHighColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Sidebar navigation button -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12 9" />
            <Setter Property="Margin" Value="0 1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListLowColor}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav.selected PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav PathIcon">
            <Setter Property="Height" Value="16" />
            <Setter Property="Width" Value="16" />
        </Style>

        <!-- Small transparent icon button (table row actions, toolbar) -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListLowColor}" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Height" Value="15" />
            <Setter Property="Width" Value="15" />
        </Style>

        <!-- Pill counter shown next to nav items -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7 1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Colored status badge -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7 2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- Hand cursor on clickable controls (#12) -->
        <Style Selector="Button"><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="ToggleButton"><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="CheckBox"><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="ToggleSwitch"><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="ComboBox"><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="DataGridColumnHeader"><Setter Property="Cursor" Value="Hand" /></Style>

        <!-- ===== Numeric stepper redesign (#1): bigger, touch-friendly, hand cursor on the arrows ===== -->
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <!-- The increase/decrease arrows are RepeatButtons inside the ButtonSpinner template -->
        <Style Selector="ButtonSpinner /template/ RepeatButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemListMediumColor}" />
        </Style>

        <!-- ===== Whole-row selection in every DataGrid; no per-cell focus border (#3, #8) ===== -->
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell:selected /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Clear, full-row selection highlight -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Opacity" Value="0.16" />
        </Style>
    </Application.Styles>
</Application>
