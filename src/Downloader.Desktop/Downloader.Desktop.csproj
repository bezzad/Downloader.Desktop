<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType Condition="'$(IsMacOS)'=='true'">Exe</OutputType>
        <OutputType Condition="'$(IsMacOS)'!='true'">WinExe</OutputType>
        <LangVersion>latest</LangVersion>
        <TargetFramework Condition="'$(IsMacBuild)'=='true'">net10.0-macos</TargetFramework>
        <TargetFramework Condition="'$(IsMacBuild)'!='true'">net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Title>Downloader</Title>
        <Description>Cross-platform Downloader application with fluent user interface</Description>
        <Copyright>2026</Copyright>
        <PackageProjectUrl>https://github.com/bezzad/Downloader.Desktop</PackageProjectUrl>
        <PackageLicenseUrl>https://raw.githubusercontent.com/bezzad/Downloader.Desktop/main/LICENSE</PackageLicenseUrl>
        <PackageIcon>Assets\downloader.png</PackageIcon>
        <RepositoryUrl>https://github.com/bezzad/Downloader.Desktop</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>downloader</PackageTags>
        <Company>Behzad Khosravifar</Company>
        <PackageId>Downloader.Desktop</PackageId>
        <Authors>Behzad Khosravifar</Authors>
        <Product>Downloader.Desktop</Product>
        <ApplicationId>downloader.desktop</ApplicationId>
        <ApplicationTitle>Downloader</ApplicationTitle>
        <ApplicationIcon>./Assets/downloader.ico</ApplicationIcon>
        <SelfContained>true</SelfContained>
        <CreatePackage>false</CreatePackage>
        <RuntimeIdentifiers Condition="'$(IsMacBuild)'=='true'">osx-arm64;osx-x64</RuntimeIdentifiers>
        <UseAppHost>true</UseAppHost>
        <!--<PublishSingleFile>true</PublishSingleFile>-->
        <!--<PublishTrimmed>true</PublishTrimmed>-->
        <!--<PublishReadyToRun>true</PublishReadyToRun>-->
    </PropertyGroup>

    <!-- ===== Automatic versioning (#16) =====
         VersionPrefix is the FULL major.minor.patch semantic version and must match the release tag
         (the release workflow stamps it from the tag via -p:VersionPrefix=<tag-without-v>, so the running
         app always reports exactly the released version — this is what the update check compares against).
         AssemblyVersion = VersionPrefix.0 so the app can report its real patch number (the update check
         reads Major.Minor.Build); the 4th component (a unique, increasing revision = half-seconds since
         midnight UTC) only differentiates builds in FileVersion. Keep VersionPrefix three-part. -->
    <PropertyGroup Label="Versioning">
        <VersionPrefix>2.9.0</VersionPrefix>
        <_RevisionNumber>$([System.Convert]::ToInt32($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalSeconds), 2))))</_RevisionNumber>
        <Version>$(VersionPrefix).$(_RevisionNumber)</Version>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup>
        <CFBundleName>Downloader</CFBundleName> <!-- Also defines .app file name -->
        <CFBundleDisplayName>Downloader</CFBundleDisplayName>
        <CFBundleIdentifier>com.bezzad.downloader</CFBundleIdentifier>
        <CFBundleVersion>$(Version)</CFBundleVersion>
        <CFBundleShortVersionString>$(VersionPrefix)</CFBundleShortVersionString>
        <CFBundlePackageType>APPL</CFBundlePackageType>
        <CFBundleExecutable>Downloader</CFBundleExecutable>
        <CFBundleIconFile>downloader.icns</CFBundleIconFile> <!-- Will be copied from output directory -->
        <NSPrincipalClass>Downloader</NSPrincipalClass>
        <NSHighResolutionCapable>true</NSHighResolutionCapable>
    </PropertyGroup>
    
    <ItemGroup>
        <MauiIcon Include="Assets\downloader.ico" />
    </ItemGroup>
    
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />

        <!-- A copy of the browser extension, bundled so "Install browser extension" works on a fresh
             install: offline, and BEFORE any release carries extension-catalog.json. Without this the
             feature is dead on arrival — the catalog only appears in the release that ships the feature,
             so it could not be verified before shipping. The catalog still wins when it is reachable, so
             the extension keeps updating independently of the app; this is the floor, not the source of
             truth. Kept in sync with COMMON in scripts/build-extension.sh by BundledExtensionTests. -->
        <AvaloniaResource Include="..\browser-extension\manifest.json" Link="Assets\extension\manifest.json" />
        <AvaloniaResource Include="..\browser-extension\manifest.firefox.json" Link="Assets\extension\manifest.firefox.json" />
        <AvaloniaResource Include="..\browser-extension\background.js" Link="Assets\extension\background.js" />
        <AvaloniaResource Include="..\browser-extension\common.js" Link="Assets\extension\common.js" />
        <AvaloniaResource Include="..\browser-extension\popup.html" Link="Assets\extension\popup.html" />
        <AvaloniaResource Include="..\browser-extension\popup.css" Link="Assets\extension\popup.css" />
        <AvaloniaResource Include="..\browser-extension\popup.js" Link="Assets\extension\popup.js" />
        <AvaloniaResource Include="..\browser-extension\options.html" Link="Assets\extension\options.html" />
        <AvaloniaResource Include="..\browser-extension\options.css" Link="Assets\extension\options.css" />
        <AvaloniaResource Include="..\browser-extension\options.js" Link="Assets\extension\options.js" />
        <AvaloniaResource Include="..\browser-extension\icons\*.png" Link="Assets\extension\icons\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaXaml Remove="Assets\Icons.axaml" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\downloads.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.ThemeManager" Version="11.2.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.17" />
        <PackageReference Include="Downloader" Version="5.9.6" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
        <PackageReference Include="Dotnet.Bundle" Version="0.9.13" />
        <PackageReference Include="Svg.Skia" Version="5.1.1" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Update="Assets\Icons.axaml">
            <SubType>Designer</SubType>
        </AvaloniaResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\SettingView.axaml.cs">
            <DependentUpon>HeadView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\DownloadsView.axaml.cs">
            <DependentUpon>DownloadsView.axaml</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Downloader.Desktop.Plugins.Abstractions\Downloader.Desktop.Plugins.Abstractions.csproj" />
      <!-- Bundled plugins: built (ordering only, never compile-referenced) and staged into
           $(OutDir)/plugins + $(PublishDir)/plugins by the targets below, where PluginManager.LoadBuiltIns
           picks them up at startup. -->
      <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.GitHub\Downloader.Desktop.Plugins.GitHub.csproj"
                        ReferenceOutputAssembly="false" Private="false" />
      <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.Ollama\Downloader.Desktop.Plugins.Ollama.csproj"
                        ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Downloader.Desktop.Tests" />
    </ItemGroup>

    <!-- Stage the BUILT-IN plugins' DLL + deps.json into the app output (and the publish output) as
         plugins/. This is an EXPLICIT per-plugin glob allow-list, NOT a wildcard over
         Downloader.Desktop.Plugins\* : optional/catalog-tier plugins (e.g. Downloader.Desktop.Plugins.Hls)
         live in the same parent folder but must NEVER be bundled into the app — they ship only as
         downloadable release assets (see the consolidate-official-plugins change). Adding a new BUILT-IN
         plugin means adding its two globs here; a new OPTIONAL plugin needs no change and stays
         un-bundled. (Safe-failure direction: forgetting to list a built-in just leaves it unbundled; the
         reverse — a wildcard sweeping up an optional plugin — is the bug this allow-list prevents.)
         RID-agnostic recursive glob: a parallel/self-contained build can drop plugin output under a RID
         subfolder, so never hardcode bin/<cfg>/net10.0 (see the test project's identical gotcha). ref/
         assemblies are metadata-only and can't be loaded. -->
    <PropertyGroup>
        <_GitHubPluginBin>..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.GitHub\bin\$(Configuration)</_GitHubPluginBin>
        <_OllamaPluginBin>..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.Ollama\bin\$(Configuration)</_OllamaPluginBin>
    </PropertyGroup>

    <Target Name="StageBundledPlugins" AfterTargets="Build">
        <ItemGroup>
            <BundledPluginFile Include="$(_GitHubPluginBin)\**\Downloader.Desktop.Plugins.*.dll;$(_OllamaPluginBin)\**\Downloader.Desktop.Plugins.*.dll"
                               Exclude="$(_GitHubPluginBin)\**\ref\**;$(_OllamaPluginBin)\**\ref\**" />
            <BundledPluginFile Include="$(_GitHubPluginBin)\**\Downloader.Desktop.Plugins.*.deps.json;$(_OllamaPluginBin)\**\Downloader.Desktop.Plugins.*.deps.json" />
        </ItemGroup>
        <Error Condition="'@(BundledPluginFile)' == ''"
               Text="StageBundledPlugins: no bundled plugin outputs found — did the built-in plugin projects build for '$(Configuration)'?" />
        <Copy SourceFiles="@(BundledPluginFile)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="StageBundledPluginsOnPublish" AfterTargets="Publish">
        <ItemGroup>
            <BundledPluginPubFile Include="$(_GitHubPluginBin)\**\Downloader.Desktop.Plugins.*.dll;$(_OllamaPluginBin)\**\Downloader.Desktop.Plugins.*.dll"
                                  Exclude="$(_GitHubPluginBin)\**\ref\**;$(_OllamaPluginBin)\**\ref\**" />
            <BundledPluginPubFile Include="$(_GitHubPluginBin)\**\Downloader.Desktop.Plugins.*.deps.json;$(_OllamaPluginBin)\**\Downloader.Desktop.Plugins.*.deps.json" />
        </ItemGroup>
        <Copy SourceFiles="@(BundledPluginPubFile)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
    </Target>
</Project>
