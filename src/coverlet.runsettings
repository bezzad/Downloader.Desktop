<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the XPlat Code Coverage collector.

  Purpose: keep the denominator to code we actually author. Before this file, ~2100 of the ~13300
  measured lines were Roslyn source-generator output — chiefly a 1958-line RegexGenerator DFA in the
  Website plugin — which is emitted, not written, and cannot be meaningfully unit-tested. Leaving it
  in cost roughly ten percentage points and hid the real picture (51.5% raw vs 61.2% for real code).

  Use it with:  dotnet test … (see CONTRIBUTING) with: settings coverlet.runsettings
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Generated code carries [GeneratedCode]; hand-written code marked
               [ExcludeFromCodeCoverage] is opted out deliberately. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Belt and braces: the regex generator's output lives under obj/ and is *.g.cs. Source
               generators do not always stamp every emitted member with [GeneratedCode]. -->
          <ExcludeByFile>**/obj/**/*.g.cs,**/*.g.cs,**/*.Designer.cs</ExcludeByFile>
          <!-- The test project itself is not the subject under measurement. -->
          <Exclude>[Downloader.Desktop.Tests]*,[xunit.*]*</Exclude>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
