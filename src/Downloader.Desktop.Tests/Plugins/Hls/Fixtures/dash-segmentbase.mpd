<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT30S"
     profiles="urn:mpeg:dash:profile:isoff-on-demand:2011">
  <BaseURL>https://cdn.example.com/od/</BaseURL>
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <Representation id="v1" bandwidth="3000000" width="1920" height="1080">
        <BaseURL>movie-video.mp4</BaseURL>
        <SegmentBase indexRange="900-1200">
          <Initialization range="0-899"/>
        </SegmentBase>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4">
      <Representation id="a1" bandwidth="192000">
        <BaseURL>movie-audio.mp4</BaseURL>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
