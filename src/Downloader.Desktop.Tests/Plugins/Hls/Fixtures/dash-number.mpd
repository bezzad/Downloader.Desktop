<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static"
     mediaPresentationDuration="PT20S"
     profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <SegmentTemplate timescale="90000" duration="450000" startNumber="1"
                       initialization="video/$Bandwidth$/init.mp4"
                       media="video/$Bandwidth$/chunk-$Number%04d$.m4s"/>
      <Representation id="v1" bandwidth="1500000" width="854" height="480"/>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4">
      <SegmentTemplate timescale="90000" duration="450000" startNumber="1"
                       initialization="audio/init.mp4"
                       media="audio/chunk-$Number%04d$.m4s"/>
      <Representation id="a1" bandwidth="96000"/>
    </AdaptationSet>
  </Period>
</MPD>
