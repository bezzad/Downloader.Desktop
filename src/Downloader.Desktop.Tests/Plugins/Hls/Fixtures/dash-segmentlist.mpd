<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT12S">
  <BaseURL>https://cdn.example.com/base/</BaseURL>
  <Period>
    <BaseURL>period1/</BaseURL>
    <AdaptationSet mimeType="video/mp4">
      <Representation id="v1" bandwidth="900000" width="640" height="360">
        <BaseURL>v1/</BaseURL>
        <SegmentList duration="4">
          <Initialization sourceURL="init.mp4"/>
          <SegmentURL media="s1.m4s"/>
          <SegmentURL media="s2.m4s"/>
          <SegmentURL media="s3.m4s"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
