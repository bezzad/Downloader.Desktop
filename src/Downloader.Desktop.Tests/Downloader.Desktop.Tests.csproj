<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- "annotations" = ? and ! are understood, but no nullable WARNINGS are raised. Plain "disable"
             made every `string?` in a test file a CS8632 ("annotation used outside a #nullable context"),
             and tests do legitimately want to say "this may be null". Keeps the zero-warning rule (see
             CLAUDE.md) satisfiable without a nullable-annotation sweep of the whole suite. -->
        <Nullable>annotations</Nullable>
        <!-- Implicit usings on: the consolidated HLS tests (Plugins/Hls/) were authored against them
             (System, System.Threading.Tasks, System.Collections.Generic, …). Existing tests keep their
             explicit usings — implicit + explicit coexist without conflict. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- The app project is self-contained, so the test project must be too (matches host RID). -->
        <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Downloader.Desktop\Downloader.Desktop.csproj" />
        <ProjectReference Include="..\Downloader.Desktop.Plugins.Abstractions\Downloader.Desktop.Plugins.Abstractions.csproj" />
        <!-- Build the GitHub plugin (but DON'T reference it for compilation) so the loader integration
             test can load it from disk as a real external DLL. -->
        <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.GitHub\Downloader.Desktop.Plugins.GitHub.csproj" ReferenceOutputAssembly="false" Private="false" />
        <!-- The Ollama plugin IS compile-referenced: its pure logic (claim parsing, manifest parsing,
             installer) is unit-tested directly. ALC loading is already covered by the GitHub plugin test. -->
        <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.Ollama\Downloader.Desktop.Plugins.Ollama.csproj" />
        <!-- The optional HLS plugin IS compile-referenced: its tests (Plugins/Hls/) call internal types
             directly, and its DLL lands in the test output so
             PluginLoadTests can load it in a host-mirroring ALC. Referencing an OPTIONAL plugin from the
             TEST project is fine — the isolation rule only bars the APP project from referencing it
             (guarded by PluginIsolationTests). -->
        <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.Hls\Downloader.Desktop.Plugins.Hls.csproj" />
        <!-- The optional Website plugin is compile-referenced the same way: its tests (Plugins/Website/)
             call internal types (SiteCrawler, LinkExtractor, LocalPathMapper, …) directly. -->
        <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.Website\Downloader.Desktop.Plugins.Website.csproj" />
        <!-- The optional site-media plugin, likewise: its tests (Plugins/SiteMedia/) call internal
             types (ToolChecksum, the argument builder). Referencing an OPTIONAL plugin from the TEST
             project is fine — the isolation rule bars only the APP project (PluginIsolationTests). -->
        <ProjectReference Include="..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.SiteMedia\Downloader.Desktop.Plugins.SiteMedia.csproj" />
    </ItemGroup>

    <!-- HLS plugin test fixtures (sample playlists) → <testout>/Fixtures, where TestFixtures.Dir reads them. -->
    <ItemGroup>
        <None Include="Plugins\Hls\Fixtures\**\*">
            <Link>Fixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Stage the built GitHub plugin DLL into <testout>/plugins-sample so the integration test can load it.
         The plugin may land in the plain TFM folder (bin/<cfg>/net10.0/) OR a RID subfolder: this test
         project is self-contained with a RuntimeIdentifier, and a parallel solution build can propagate that
         RID to the referenced plugin, so its DLL races between those two locations on CI. Glob recursively so
         we stage it wherever it lands; exclude the metadata-only ref/ assemblies (they can't be loaded). The
         Error turns any genuine miss into a loud build failure instead of a confusing test failure. -->
    <Target Name="StageSamplePlugin" AfterTargets="Build">
        <PropertyGroup>
            <SamplePluginBin>$(MSBuildThisFileDirectory)..\Downloader.Desktop.Plugins\Downloader.Desktop.Plugins.GitHub\bin\$(Configuration)\net10.0</SamplePluginBin>
        </PropertyGroup>
        <ItemGroup>
            <SamplePluginDll Include="$(SamplePluginBin)\**\Downloader.Desktop.Plugins.GitHub.dll" Exclude="$(SamplePluginBin)\**\ref\**" />
        </ItemGroup>
        <Error Condition="'@(SamplePluginDll)' == ''" Text="StageSamplePlugin: Downloader.Desktop.Plugins.GitHub.dll not found under $(SamplePluginBin) (searched recursively, excluding ref/). The plugin loader integration test would fail. Ensure the GitHub plugin project built for the '$(Configuration)' configuration." />
        <Copy SourceFiles="@(SamplePluginDll)" DestinationFolder="$(OutDir)plugins-sample" SkipUnchangedFiles="true" />
    </Target>
</Project>
