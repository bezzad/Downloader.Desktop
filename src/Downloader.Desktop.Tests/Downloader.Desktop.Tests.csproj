<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- The app project is self-contained, so the test project must be too (matches host RID). -->
        <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Downloader.Desktop\Downloader.Desktop.csproj" />
        <ProjectReference Include="..\Downloader.Desktop.Plugins.Abstractions\Downloader.Desktop.Plugins.Abstractions.csproj" />
        <!-- Build the sample plugin (but DON'T reference it for compilation) so the loader integration
             test can load it from disk as a real external DLL. -->
        <ProjectReference Include="..\..\samples\Downloader.Desktop.SamplePlugin\Downloader.Desktop.SamplePlugin.csproj"
                          ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>

    <!-- Stage the built sample plugin DLL into <testout>/plugins-sample so the integration test can load it. -->
    <Target Name="StageSamplePlugin" AfterTargets="Build">
        <ItemGroup>
            <SamplePluginDll Include="$(MSBuildThisFileDirectory)..\..\samples\Downloader.Desktop.SamplePlugin\bin\$(Configuration)\net10.0\Downloader.Desktop.SamplePlugin.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(SamplePluginDll)" DestinationFolder="$(OutDir)plugins-sample"
              SkipUnchangedFiles="true" Condition="Exists('@(SamplePluginDll)')" />
    </Target>
</Project>
