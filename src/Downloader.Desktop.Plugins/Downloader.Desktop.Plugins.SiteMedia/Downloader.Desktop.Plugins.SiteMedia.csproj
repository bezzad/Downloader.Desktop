<Project Sdk="Microsoft.NET.Sdk">
  <!-- OPTIONAL / catalog-tier plugin (site page → media file, via yt-dlp).
       Built and tested as part of the solution, but NEVER referenced by or staged into the app's own
       output — it ships only as a downloadable release asset (see docs/plugins-architecture.md). Do NOT
       add a ProjectReference to this from Downloader.Desktop, and do NOT add it to the app's
       StageBundledPlugins allow-list. PluginIsolationTests enforces both.

       This plugin is the ONLY place in the repo that runs a third-party extraction binary, and it does so
       from an absolute path with no shell (issue #4). It never reads a browser profile or cookie store:
       a signed-in session reaches it only as a cookie FILE the browser extension handed over. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Downloader.Desktop.Plugins.SiteMedia</AssemblyName>
    <RootNamespace>Downloader.Desktop.Plugins.SiteMedia</RootNamespace>
    <!-- This plugin carries its OWN version, independent of the app's VersionPrefix. Bump it whenever the
         plugin's code changes; the catalog/update flow compares this against the running copy. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Downloader.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Downloader.Desktop.Plugins.Abstractions\Downloader.Desktop.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
