<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bundled plugin: download Ollama models by name/URL and install them into the local Ollama store.
       EnableDynamicLoading emits the deps.json the host's AssemblyDependencyResolver needs. The
       Abstractions SDK is referenced but NOT shipped with the plugin (Private=false) — the host provides
       it so plugin types unify with the host's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin's tests (Plugins/HuggingFaceTests.cs) call internal helpers such as the
         repository-listing parser, which is where the API's real JSON shape is pinned. -->
    <InternalsVisibleTo Include="Downloader.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Downloader.Desktop.Plugins.Abstractions\Downloader.Desktop.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
